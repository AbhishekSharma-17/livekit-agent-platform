{
  "$id": "lkap-contracts/InternalKbSearchRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``POST /internal/v1/kb/search`` (service token).",
  "properties": {
    "k": {
      "default": 4,
      "maximum": 20,
      "minimum": 1,
      "title": "K",
      "type": "integer"
    },
    "kb_ids": {
      "items": {
        "type": "string"
      },
      "title": "Kb Ids",
      "type": "array"
    },
    "min_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Drop hits whose `score` is below this; the response's `dropped` counts them.",
      "title": "Min Score"
    },
    "mode": {
      "default": "vector",
      "description": "`vector` (embedding similarity) or `hybrid` (keyword matches fused with it by rank).",
      "enum": [
        "vector",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "query": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "rerank": {
      "default": "none",
      "description": "`local` rescores the top candidates with the local cross-encoder.",
      "enum": [
        "none",
        "local"
      ],
      "title": "Rerank",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The session searching; when set, only knowledge bases of that session's workspace are searched (S5-29). Null from a pre-V5-27 worker.",
      "title": "Session Id"
    }
  },
  "required": [
    "kb_ids",
    "query"
  ],
  "title": "InternalKbSearchRequest",
  "type": "object"
}
