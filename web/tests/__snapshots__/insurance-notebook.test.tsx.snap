// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden UiState fixtures > renders the blank intake page 1`] = `"<li data-key="empty" data-kind="aside" class="note aside ink-in">Waiting for the claimant. Tap Talk, show the camera, or type below.</li>"`;

exports[`golden UiState fixtures > renders the flood claim page 1`] = `"<li data-key="title:Maya Singh|H0-44721" data-kind="title" class="note title ink-in">Maya Singh  ·  H0-44721</li><li data-key="policy:H0-44721:active" data-kind="check" class="note check ink-in">Homeowners (HO-3), active. Dwelling $620,000</li><li data-key="whenwhere:last night|Denver" data-kind="note" class="note ink-in">Denver, last night</li><li data-key="desc:Finished basement flooded when the sump pump failed during heavy rain." data-kind="note" class="note ink-in">Finished basement flooded when the sump pump failed during heavy rain.</li><li data-key="inj:No injuries reported" data-kind="note" class="note ink-in">No injuries reported</li><li data-key="ev:photos, short video" data-kind="aside" class="note aside ink-in">Has: photos, short video</li><li data-key="blank:contact_method" data-kind="blank" class="note blank ink-in">Best contact?<span aria-hidden="true" class="blank-line"></span></li><li data-key="blank:Exact date of loss (claimant said last night, calendar date not confirmed)" data-kind="blank" class="note blank ink-in">Exact date of loss?<span aria-hidden="true" class="blank-line"></span></li><li data-key="blank:Whether a plumber or mitigation company has already inspected the sump pump and basement walls" data-kind="blank" class="note blank ink-in">Whether a plumber or mitigation company...?<span aria-hidden="true" class="blank-line"></span></li>"`;

exports[`golden UiState fixtures > renders the injured auto claim page with its escalation stamp 1`] = `"<li data-key="title:Chris Park|AUTO-11111" data-kind="title" class="note title ink-in">Chris Park  ·  AUTO-11111</li><li data-key="policy:AUTO-11111:lapsed" data-kind="flag" class="note flag urgent ink-in">Personal auto, lapsed. Human review before anything else.</li><li data-key="whenwhere:|SE 12th and Hawthorne, Portland" data-kind="note" class="note ink-in">SE 12th and Hawthorne, Portland</li><li data-key="desc:Another car ran a red light and hit the driver's side of the claimant's car." data-kind="note" class="note ink-in">Another car ran a red light and hit the driver's side of the claimant's car.</li><li data-key="inj:Passenger has neck pain and went to urgent care" data-kind="flag" class="note flag urgent ink-in">Injury: Passenger has neck pain and went to urgent care</li><li data-key="contact:Text 503-555-0101" data-kind="aside" class="note aside ink-in">Reach at Text 503-555-0101</li><li data-key="ev:police report number PDX-24-8811, tow receipt, other driver's plate" data-kind="aside" class="note aside ink-in">Has: police report number PDX-24-8811, tow receipt, other driver's plate</li><li data-key="rep:police report number PDX-24-8811 | tow receipt | other driver's plate | police report | Another car ran a red light and hit the driver's side of the claimant's car." data-kind="aside" class="note aside ink-in">Report: police report number PDX-24-8811 | tow receipt | other driver's plate | police report | Another car ran a red light and hit the driver's side of the claimant's car.</li><li data-key="blank:date_of_loss" data-kind="blank" class="note blank ink-in">When did it happen?<span aria-hidden="true" class="blank-line"></span></li><li data-key="blank:Date of loss" data-kind="blank" class="note blank ink-in">Date of loss?<span aria-hidden="true" class="blank-line"></span></li><li data-key="blank:Repair estimate amount" data-kind="blank" class="note blank ink-in">Repair estimate amount?<span aria-hidden="true" class="blank-line"></span></li>"`;
