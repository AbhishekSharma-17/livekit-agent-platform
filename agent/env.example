# Copy to .env (humans only) or export via .claude/launch.json
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=lkap-agent
LKAP_API_BASE_URL=http://127.0.0.1:8080
LKAP_SERVICE_TOKEN=dev-service
# The generic pack only (V6-22). To keep the legacy insurance pack for existing agents:
# LKAP_PACKS=packs.insurance_claim,packs.generic (the same value on the api and every worker)
LKAP_PACKS=packs.generic
LKAP_LOG_LEVEL=INFO
LKAP_LOG_JSON=false
LKAP_VISION_MAX_FRAME_AGE_S=8
LKAP_IDLE_HANGUP_S=120
# Seconds one live-extraction call may take (1-60). It runs beside the reply, never before it.
LKAP_EXTRACTION_TIMEOUT_S=10
