{
  "$defs": {
    "ConsentRecord": {
      "description": "One answer as ``sessions.consent_state`` keeps it: the event plus when it happened (epoch seconds).",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "at": {
          "title": "At",
          "type": "number"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The consent block answered, if there is one.",
          "title": "Block Id"
        },
        "kind": {
          "enum": [
            "recording",
            "ai_disclosure",
            "terms",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "tap",
            "voice"
          ],
          "title": "Method",
          "type": "string"
        },
        "text_hash": {
          "description": "SHA-256 of the exact text, lowercase hex.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A voice answer's user turn (the transcript row it was heard in); null for a tap and for events written before V5-27.",
          "title": "Turn Id"
        }
      },
      "required": [
        "kind",
        "accepted",
        "method",
        "text_hash",
        "at"
      ],
      "title": "ConsentRecord",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ConsentState.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``sessions.consent_state``: the latest answer per consent kind (a later answer replaces it).",
  "properties": {
    "latest": {
      "additionalProperties": {
        "$ref": "#/$defs/ConsentRecord"
      },
      "default": {},
      "propertyNames": {
        "enum": [
          "recording",
          "ai_disclosure",
          "terms",
          "custom"
        ]
      },
      "title": "Latest",
      "type": "object"
    },
    "withdrawn_at": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "description": "When an accepted answer was replaced by a decline (epoch seconds), per kind (V5-27, S5-5): for `recording` the worker stops the Egress then.",
      "propertyNames": {
        "enum": [
          "recording",
          "ai_disclosure",
          "terms",
          "custom"
        ]
      },
      "title": "Withdrawn At",
      "type": "object"
    }
  },
  "title": "ConsentState",
  "type": "object"
}
