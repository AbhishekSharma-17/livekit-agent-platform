{
  "$defs": {
    "CapabilitiesConfig": {
      "description": "Which input affordances the session page offers.",
      "properties": {
        "camera": {
          "default": false,
          "title": "Camera",
          "type": "boolean"
        },
        "chat_input": {
          "default": true,
          "title": "Chat Input",
          "type": "boolean"
        },
        "dtmf": {
          "default": false,
          "title": "Dtmf",
          "type": "boolean"
        },
        "screen_share": {
          "default": false,
          "title": "Screen Share",
          "type": "boolean"
        },
        "vision_inject_per_turn": {
          "default": true,
          "title": "Vision Inject Per Turn",
          "type": "boolean"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/AgentPublicOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What an unauthenticated browser may see about a published agent.",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/CapabilitiesConfig"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "pipeline_mode": {
      "enum": [
        "realtime",
        "cascaded",
        "half_cascade"
      ],
      "title": "Pipeline Mode",
      "type": "string"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "ui_panel_id": {
      "title": "Ui Panel Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "description",
    "ui_panel_id",
    "capabilities",
    "pipeline_mode"
  ],
  "title": "AgentPublicOut",
  "type": "object"
}
