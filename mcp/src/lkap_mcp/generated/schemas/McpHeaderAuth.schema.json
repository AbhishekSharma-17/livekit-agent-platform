{
  "$id": "lkap-contracts/McpHeaderAuth.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Static request headers, typically an API key (research-v4 tools §4.3.1).\n\nHeader values may reference ``{{ secret.NAME }}``; the api substitutes them from\n``credential_id`` (an ``http-tool-secret`` bag) when a session resolves.",
  "properties": {
    "credential_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Id"
    },
    "headers": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Headers",
      "type": "object"
    },
    "kind": {
      "const": "header",
      "default": "header",
      "title": "Kind",
      "type": "string"
    }
  },
  "title": "McpHeaderAuth",
  "type": "object"
}
