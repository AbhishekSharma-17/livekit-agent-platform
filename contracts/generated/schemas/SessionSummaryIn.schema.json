{
  "$defs": {
    "ActivityEvent": {
      "description": "A tool call, workflow run or escalation rendered as a \"team feed\" entry.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "phase": {
          "enum": [
            "running",
            "done",
            "error",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "urgent": {
          "default": false,
          "title": "Urgent",
          "type": "boolean"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "ts",
        "source",
        "label",
        "phase",
        "headline"
      ],
      "title": "ActivityEvent",
      "type": "object"
    },
    "AssetRef": {
      "description": "Points at bytes already delivered on the ``lkap.ui.asset`` byte stream.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "meta": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Meta",
          "type": "object"
        },
        "mime": {
          "title": "Mime",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "mime",
        "ts"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ChecklistItem": {
      "description": "One \"still needed\" item.",
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "Note": {
      "description": "A line in the panel's notes list. A repeated ``key`` upserts in place.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "kind": {
          "default": "note",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "default": "neutral",
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ],
          "title": "Tone",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "ts"
      ],
      "title": "Note",
      "type": "object"
    },
    "StatusStamp": {
      "description": "The big \"stamp\" shown by a panel; ``key`` changes re-trigger the animation.",
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tone": {
          "default": "neutral",
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "StatusStamp",
      "type": "object"
    },
    "TranscriptTurn": {
      "description": "One turn of the final transcript (images stripped).",
      "properties": {
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "role",
        "text",
        "ts"
      ],
      "title": "TranscriptTurn",
      "type": "object"
    },
    "UiState": {
      "description": "The platform envelope every panel renders; ``custom`` is pack-defined.\n\n``v`` accepts ``1`` for one release so v1 producers (and the web reducer's\nown literals) keep validating while panels migrate to blocks.",
      "properties": {
        "activity": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActivityEvent"
          },
          "title": "Activity",
          "type": "array"
        },
        "assets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "title": "Assets",
          "type": "array"
        },
        "blocks": {
          "additionalProperties": true,
          "default": {},
          "title": "Blocks",
          "type": "object"
        },
        "checklist": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "title": "Checklist",
          "type": "array"
        },
        "custom": {
          "additionalProperties": true,
          "default": {},
          "title": "Custom",
          "type": "object"
        },
        "notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Note"
          },
          "title": "Notes",
          "type": "array"
        },
        "progress": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatusStamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "v": {
          "default": 2,
          "enum": [
            1,
            2
          ],
          "title": "V",
          "type": "integer"
        }
      },
      "title": "UiState",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/SessionSummaryIn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``PUT /internal/v1/sessions/{id}/summary`` — posted from a shutdown callback.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "final_ui_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "ended",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "transcript": {
      "items": {
        "$ref": "#/$defs/TranscriptTurn"
      },
      "title": "Transcript",
      "type": "array"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    }
  },
  "required": [
    "status",
    "usage",
    "transcript"
  ],
  "title": "SessionSummaryIn",
  "type": "object"
}
