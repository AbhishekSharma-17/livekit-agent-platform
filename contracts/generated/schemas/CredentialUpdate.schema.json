{
  "$id": "lkap-contracts/CredentialUpdate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``PUT /v1/credentials/{id}`` — omitting ``secrets`` keeps the stored values.",
  "properties": {
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Id"
    },
    "secrets": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secrets"
    }
  },
  "title": "CredentialUpdate",
  "type": "object"
}
