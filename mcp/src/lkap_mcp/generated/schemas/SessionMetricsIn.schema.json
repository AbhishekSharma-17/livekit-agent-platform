{
  "$defs": {
    "CostLine": {
      "description": "One priced usage line of a session.\n\n``cost_usd`` is ``None`` with ``note=\"no price\"`` when the price table has\nno entry — an unknown price is never reported as zero.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "enum": [
            "tokens_in",
            "tokens_out",
            "audio_s_in",
            "audio_s_out",
            "chars",
            "minutes",
            "images"
          ],
          "title": "Unit",
          "type": "string"
        },
        "unit_price_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price Usd"
        }
      },
      "required": [
        "provider_id",
        "unit",
        "quantity"
      ],
      "title": "CostLine",
      "type": "object"
    },
    "SessionLatency": {
      "description": "Per-session latency percentiles collected from ``metrics_collected``.",
      "properties": {
        "eou_to_first_audio_ms_p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eou To First Audio Ms P50"
        },
        "eou_to_first_audio_ms_p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eou To First Audio Ms P95"
        },
        "llm_ttft_ms_p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Ttft Ms P50"
        },
        "llm_ttft_ms_p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Ttft Ms P95"
        },
        "tts_ttfb_ms_p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts Ttfb Ms P50"
        },
        "tts_ttfb_ms_p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts Ttfb Ms P95"
        },
        "turns": {
          "default": 0,
          "title": "Turns",
          "type": "integer"
        }
      },
      "title": "SessionLatency",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/SessionMetricsIn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``POST /internal/v1/sessions/{id}/metrics``.",
  "properties": {
    "latency": {
      "$ref": "#/$defs/SessionLatency",
      "default": {
        "eou_to_first_audio_ms_p50": null,
        "eou_to_first_audio_ms_p95": null,
        "llm_ttft_ms_p50": null,
        "llm_ttft_ms_p95": null,
        "tts_ttfb_ms_p50": null,
        "tts_ttfb_ms_p95": null,
        "turns": 0
      }
    },
    "usage_lines": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CostLine"
      },
      "title": "Usage Lines",
      "type": "array"
    }
  },
  "title": "SessionMetricsIn",
  "type": "object"
}
