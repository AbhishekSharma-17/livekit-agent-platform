{
  "$id": "lkap-contracts/WorkerEnv.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /internal/v1/connections/{id}/worker-env`` — decrypted, supervisor only.\n\n``env`` holds the complete child environment (``LIVEKIT_*``, ``LKAP_*``,\n``OTEL_*``). Never log it.",
  "properties": {
    "agent_name": {
      "default": "lkap-agent",
      "title": "Agent Name",
      "type": "string"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Env",
      "type": "object"
    },
    "image": {
      "default": "slim",
      "title": "Image",
      "type": "string"
    }
  },
  "title": "WorkerEnv",
  "type": "object"
}
