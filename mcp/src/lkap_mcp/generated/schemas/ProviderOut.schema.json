{
  "$defs": {
    "CatalogFilter": {
      "description": "Which vendor list items a registry entry keeps (D-V4-25, R-V4-28).\n\nApplied by the api after the adapter fetch, so one vendor adapter can\nserve several entries (OpenAI's one ``/models`` list feeds six). Every\nset condition must hold: ``id_include`` must match, ``id_exclude`` must\nnot (both :func:`re.search`, case-insensitive), and the list at the dotted\n``meta_path`` must contain ``meta_contains``.",
      "properties": {
        "id_exclude": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Exclude"
        },
        "id_include": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Include"
        },
        "meta_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Contains"
        },
        "meta_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Path"
        }
      },
      "title": "CatalogFilter",
      "type": "object"
    },
    "CatalogSpec": {
      "description": "How to list a provider's models, voices, avatars or personas from the vendor.\n\n``filter`` and ``page`` (V4-07, D-V4-25) are registry data the api applies\naround the adapter: ``filter`` keeps this entry's items out of a shared\nvendor list, ``page`` follows the vendor's pagination.",
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kinds": {
          "default": [],
          "items": {
            "enum": [
              "models",
              "voices",
              "avatars",
              "personas"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ttl_s": {
          "default": 3600,
          "title": "Ttl S",
          "type": "integer"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "CatalogSpec",
      "type": "object"
    },
    "FieldSpec": {
      "description": "One configurable constructor argument of a provider.",
      "properties": {
        "accept": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accept"
        },
        "catalog_kind": {
          "anyOf": [
            {
              "enum": [
                "models",
                "voices",
                "avatars",
                "personas"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Kind"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "env_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env Fallback"
        },
        "help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nested Model"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "positional": {
          "default": false,
          "title": "Positional",
          "type": "boolean"
        },
        "recommended": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value the console pre-selects for a new agent (V6-02, D-V6-4c). `default` stays the value a stored reference without the field resolves to (the plugin's own behaviour), so an existing agent never changes; `recommended` is what a new one should use.",
          "title": "Recommended"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "secret",
            "number",
            "boolean",
            "enum",
            "json",
            "model",
            "file",
            "catalog"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "ModelSpec": {
      "description": "A suggested model id for a provider (a suggestion list, never an allowlist).",
      "properties": {
        "deprecated": {
          "default": false,
          "description": "The vendor deprecated this id (V6-02, D-V6-4a). It stays listed so a stored reference still resolves; the validator warns and the console offers the entry's `default_model`.",
          "title": "Deprecated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "V6-31: the model thinks before it answers. Set only where the plugin source or the vendor's published listing says so; `null` = unknown (the live catalog decides).",
          "title": "Reasoning"
        },
        "reasoning_efforts": {
          "default": [],
          "description": "V6-31: the `reasoning_effort` values the model accepts through this provider, lowest first. Empty = not recorded.",
          "items": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "type": "string"
          },
          "title": "Reasoning Efforts",
          "type": "array"
        },
        "supports_video": {
          "default": false,
          "description": "Accepts visual input: video frames for realtime models, image content parts for LLMs. Set only after the platform has verified it.",
          "title": "Supports Video",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "PageSpec": {
      "description": "How to follow a vendor list's pages (D-V4-25).\n\n* ``token`` / ``cursor``: send ``param=<value at next_path>`` until the\n  value is missing or empty (Gemini ``pageToken``/``nextPageToken``,\n  Anthropic ``after_id``/``last_id``, Cartesia ``starting_after``/``next_page``).\n* ``offset``: send ``param=<items so far>`` until a short or empty page.\n* ``page``: send ``param=<n>`` from 0 (``page_number``), stopping at the\n  total page count read from ``next_path`` or at an empty page (Hume).\n\n``more_path`` (optional) names a boolean such as ``has_more``; ``false``\nstops the loop before another request. ``size_param=size`` rides on\nevery request. The loop never exceeds ``max_pages``.",
      "properties": {
        "kind": {
          "enum": [
            "cursor",
            "token",
            "offset",
            "page"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_pages": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "more_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "More Path"
        },
        "next_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Path"
        },
        "param": {
          "title": "Param",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "size_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Param"
        }
      },
      "required": [
        "kind",
        "param"
      ],
      "title": "PageSpec",
      "type": "object"
    },
    "ProviderCapabilities": {
      "description": "What a provider can do, used to gate UI affordances and runtime behaviour.",
      "properties": {
        "audio_input": {
          "default": true,
          "title": "Audio Input",
          "type": "boolean"
        },
        "avatar_aspect": {
          "anyOf": [
            {
              "enum": [
                "portrait",
                "landscape",
                "square"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Avatar only (V6-26): the vendor's documented native video aspect, cited in `avatar_aspect_note`. The console (and the session stage, once a package threads it through `AgentPublicOut` — docs/v6/_asks.md #151) sizes the video well to this before the first frame arrives, so the layout does not jump. `None` = not documented (most vendors' resolution is configurable per call, or undocumented): the well waits for the real track dimensions instead of guessing.",
          "title": "Avatar Aspect"
        },
        "avatar_aspect_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Avatar only (V6-26): one line citing where `avatar_aspect` came from (the vendor's documented default resolution or aspect), e.g. 'Tavus replica video defaults to 1280x720 (docs.tavus.io)'. Unset when `avatar_aspect` is unset.",
          "title": "Avatar Aspect Note"
        },
        "cloud_only": {
          "default": false,
          "title": "Cloud Only",
          "type": "boolean"
        },
        "detect_languages": {
          "default": [],
          "description": "STT only (V5-31): the base codes automatic detection covers when it is narrower than `languages` (Deepgram's `multi` covers ten). Empty = the same as `languages`.",
          "items": {
            "type": "string"
          },
          "title": "Detect Languages",
          "type": "array"
        },
        "end_of_turn": {
          "default": false,
          "description": "STT only (V6-02, D-V6-5): the transcriber decides when the caller's turn ends (Deepgram Flux). The worker then runs the session with the SDK's `turn_detection=\"stt\"` instead of the platform's default turn detector.",
          "title": "End Of Turn",
          "type": "boolean"
        },
        "language_detection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STT only (V5-31): the value of the entry's `language` field that makes the transcriber detect the language itself (`multi` for Deepgram and LiveKit Inference, `unknown` for Sarvam; the worker maps `multi` to `detect_language` for the OpenAI transcriptions class). Unset = the entry cannot be asked to detect the language.",
          "title": "Language Detection"
        },
        "language_switch": {
          "default": false,
          "description": "STT only (V5-31): `update_options(language=...)` changes the language of a running transcriber (checked against the plugin source for livekit-agents 1.8.3). False = a mid-call switch leaves the transcriber as it is.",
          "title": "Language Switch",
          "type": "boolean"
        },
        "languages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "platforms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        },
        "redaction": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redaction",
          "type": "array"
        },
        "silent_tool_reply": {
          "default": false,
          "title": "Silent Tool Reply",
          "type": "boolean"
        },
        "streaming": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STT and TTS only (V6-02, D-V6-2): whether the entry streams with its registry defaults, from the plugin's `STTCapabilities`/`TTSCapabilities(streaming=...)` at livekit-agents 1.8.3. A transcriber that streams gives live partial transcripts; a voice that streams starts speaking before the whole sentence is written. `false` = one whole request per utterance or sentence (the SDK wraps it in a `StreamAdapter`). `null` = not recorded; `streaming_note` then says why. See `speech_streams()` for a stored reference.",
          "title": "Streaming"
        },
        "streaming_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STT and TTS only (V6-02): the boolean field that turns streaming on when it is off by default (`use_realtime` on `openai-stt`, `use_websocket` on `rime-tts`). A reference streams when it sets that field true.",
          "title": "Streaming Field"
        },
        "streaming_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STT and TTS only (V6-02): when streaming depends on something else (a model, a voice, an endpoint), in plain words.",
          "title": "Streaming Note"
        },
        "text_modality": {
          "default": false,
          "title": "Text Modality",
          "type": "boolean"
        },
        "tool_calling": {
          "default": true,
          "title": "Tool Calling",
          "type": "boolean"
        },
        "video_input": {
          "default": false,
          "title": "Video Input",
          "type": "boolean"
        },
        "vision": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vision"
        },
        "voices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Voices",
          "type": "array"
        },
        "voices_dynamic": {
          "default": false,
          "title": "Voices Dynamic",
          "type": "boolean"
        }
      },
      "title": "ProviderCapabilities",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ProviderOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A registry entry plus this workspace's settings (``GET /v1/providers``).",
  "properties": {
    "availability": {
      "default": "available",
      "enum": [
        "available",
        "deferred",
        "incompatible",
        "removed"
      ],
      "title": "Availability",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/ProviderCapabilities",
      "default": {
        "audio_input": true,
        "avatar_aspect": null,
        "avatar_aspect_note": null,
        "cloud_only": false,
        "detect_languages": [],
        "end_of_turn": false,
        "language_detection": null,
        "language_switch": false,
        "languages": [],
        "platforms": [],
        "redaction": [],
        "silent_tool_reply": false,
        "streaming": null,
        "streaming_field": null,
        "streaming_note": null,
        "text_modality": false,
        "tool_calling": true,
        "video_input": false,
        "vision": null,
        "voices": [],
        "voices_dynamic": false
      }
    },
    "catalog": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "credential_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The registry id whose credential rows this provider uses (its credential home, R-V4-7). Unset means the provider is its own home. The home exists, has no home of its own and declares the same secret field names.",
      "title": "Credential Provider"
    },
    "default_credential_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Credential Id"
    },
    "default_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Model"
    },
    "docs_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Docs Url"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "fields": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "title": "Fields",
      "type": "array"
    },
    "get_key_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Get Key Url"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "installed_on": {
      "items": {
        "type": "string"
      },
      "title": "Installed On",
      "type": "array"
    },
    "kind": {
      "enum": [
        "realtime",
        "stt",
        "llm",
        "tts",
        "avatar",
        "vad",
        "turn_detection",
        "noise_cancellation",
        "image_gen",
        "embedding",
        "secret_bag",
        "tool_provider",
        "web_search",
        "sms",
        "knowledge"
      ],
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "models": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelSpec"
      },
      "title": "Models",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "package": {
      "title": "Package",
      "type": "string"
    },
    "price_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A plain-language price line the console shows beside the provider when it is metered outside the price table (V5-07: LiveKit Cloud noise cancellation).",
      "title": "Price Note"
    },
    "price_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Price this entry with that registry entry's rows (docs/v4/COSTS.md D-V4-39), e.g. `openai-responses-llm` -> `openai-llm`. Never a self-reference; unset = the entry's own rows.",
      "title": "Price Ref"
    },
    "probe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The api's 'Test model' probe adapter for this entry (docs/v4/CUSTOM-MODELS.md D-V4-26): a capped POST with a payload, deliberately separate from `test` (a GET that lists). Unset means no model test; never set on vad, turn_detection or noise_cancellation.",
      "title": "Probe"
    },
    "python_class": {
      "title": "Python Class",
      "type": "string"
    },
    "requires_credential": {
      "default": true,
      "title": "Requires Credential",
      "type": "boolean"
    },
    "secret_fields": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "title": "Secret Fields",
      "type": "array"
    },
    "status": {
      "default": "mvp",
      "enum": [
        "mvp",
        "deferred"
      ],
      "title": "Status",
      "type": "string"
    },
    "telephony_variant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "noise_cancellation only (V5-07, D-V5-30): the dotted path of the variant tuned for phone audio. The worker builds it instead of `python_class` on a phone call when the agent uses the `telephony` conversation preset. Unset = the entry has no telephony variant.",
      "title": "Telephony Variant"
    },
    "test": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test"
    },
    "v": {
      "default": 2,
      "enum": [
        1,
        2
      ],
      "title": "V",
      "type": "integer"
    },
    "vendor": {
      "title": "Vendor",
      "type": "string"
    },
    "verification": {
      "default": "unverified",
      "enum": [
        "verified",
        "unverified"
      ],
      "title": "Verification",
      "type": "string"
    },
