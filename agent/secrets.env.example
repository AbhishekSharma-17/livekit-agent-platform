# Copy to agent/secrets.env (human-created; gitignored) and fill in real
# values, then:
#   cd agent
#   ../scripts/vendor_agent_deps.sh   # stage lkap-contracts/lkap-packs wheels — see agent/Dockerfile
#   lk agent create --secrets-file secrets.env    # first time only
#   lk agent deploy                               # every update after that
#
# Do NOT put LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET /
# LIVEKIT_AGENT_NAME here — LiveKit Cloud injects the first three
# automatically for a deployed agent, and the fourth is not needed: the
# worker registers as "lkap-agent" in code (docs/DECISIONS-W2.md §D-W2-11;
# agent/livekit.toml's `[agent] name` must match). If it is set anyway it must
# equal "lkap-agent" or the worker refuses to start.

# The api's PUBLIC HTTPS origin — must be reachable from LiveKit Cloud, so
# not localhost. See deploy/README.md for how to get one (deploy/docker-compose.yml
# behind a reverse proxy, or a tunnel while testing).
LKAP_API_BASE_URL=

# Must be byte-identical to the api's LKAP_SERVICE_TOKEN (deploy/api.env),
# or the worker's config resolve calls get 401.
LKAP_SERVICE_TOKEN=

LKAP_PACKS=packs.insurance_claim,packs.generic
