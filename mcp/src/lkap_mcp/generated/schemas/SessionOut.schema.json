{
  "$id": "lkap-contracts/SessionOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Session list row.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "channel": {
      "default": "web",
      "enum": [
        "web",
        "test",
        "text",
        "sip_in",
        "sip_out",
        "widget",
        "api"
      ],
      "title": "Channel",
      "type": "string"
    },
    "config_version": {
      "title": "Config Version",
      "type": "integer"
    },
    "connection_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connection Id"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disposition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "estimated_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The creation-time estimate (docs/v4/COSTS.md D-V4-43); null without one.",
      "title": "Estimated Usd"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "pipeline_mode": {
      "enum": [
        "realtime",
        "cascaded",
        "half_cascade"
      ],
      "title": "Pipeline Mode",
      "type": "string"
    },
    "reconciled_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reconciled Usd"
    },
    "recording_status": {
      "default": "none",
      "enum": [
        "none",
        "requested",
        "active",
        "ready",
        "failed"
      ],
      "title": "Recording Status",
      "type": "string"
    },
    "room_name": {
      "title": "Room Name",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "enum": [
        "created",
        "active",
        "ended",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage"
    }
  },
  "required": [
    "id",
    "agent_id",
    "agent_name",
    "config_version",
    "room_name",
    "status",
    "pipeline_mode",
    "created_at"
  ],
  "title": "SessionOut",
  "type": "object"
}
