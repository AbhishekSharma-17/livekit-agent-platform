{
  "id": "cal_com.booking_get",
  "group": "cal_com",
  "group_label": "Cal.com bookings",
  "secret_names": [
    "CAL_API_KEY"
  ],
  "docs_url": "https://cal.com/docs/api-reference/v2/introduction",
  "label": "Look up a booking",
  "summary": "Reads one booking's details.",
  "risk": "read",
  "defaults": [],
  "definition": {
    "kind": "http",
    "name": "booking_get",
    "description": "Get one booking's details.",
    "parameters": {
      "type": "object",
      "properties": {
        "booking_uid": {
          "type": "string",
          "description": "The booking's uid, from booking_list or booking_create."
        }
      },
      "required": [
        "booking_uid"
      ]
    },
    "method": "GET",
    "url": "https://api.cal.com/v2/bookings/{{ booking_uid }}",
    "headers": {
      "Authorization": "Bearer {{ secret.CAL_API_KEY }}",
      "cal-api-version": "2024-08-13"
    },
    "allowed_hosts": [
      "api.cal.com"
    ],
    "timeout_s": 10,
    "max_result_chars": 1500,
    "result_path": "/data"
  }
}
