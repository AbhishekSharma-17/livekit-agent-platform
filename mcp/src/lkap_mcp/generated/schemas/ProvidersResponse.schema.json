{
  "$defs": {
    "CatalogFilter": {
      "description": "Which vendor list items a registry entry keeps (D-V4-25, R-V4-28).\n\nApplied by the api after the adapter fetch, so one vendor adapter can\nserve several entries (OpenAI's one ``/models`` list feeds six). Every\nset condition must hold: ``id_include`` must match, ``id_exclude`` must\nnot (both :func:`re.search`, case-insensitive), and the list at the dotted\n``meta_path`` must contain ``meta_contains``.",
      "properties": {
        "id_exclude": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Exclude"
        },
        "id_include": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Include"
        },
        "meta_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Contains"
        },
        "meta_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Path"
        }
      },
      "title": "CatalogFilter",
      "type": "object"
    },
    "CatalogSpec": {
      "description": "How to list a provider's models, voices, avatars or personas from the vendor.\n\n``filter`` and ``page`` (V4-07, D-V4-25) are registry data the api applies\naround the adapter: ``filter`` keeps this entry's items out of a shared\nvendor list, ``page`` follows the vendor's pagination.",
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kinds": {
          "default": [],
          "items": {
            "enum": [
              "models",
              "voices",
              "avatars",
              "personas"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ttl_s": {
          "default": 3600,
          "title": "Ttl S",
          "type": "integer"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "CatalogSpec",
      "type": "object"
    },
    "FieldSpec": {
      "description": "One configurable constructor argument of a provider.",
      "properties": {
        "accept": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accept"
        },
        "catalog_kind": {
          "anyOf": [
            {
              "enum": [
                "models",
                "voices",
                "avatars",
                "personas"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Kind"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "env_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env Fallback"
        },
        "help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nested Model"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "positional": {
          "default": false,
          "title": "Positional",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "secret",
            "number",
            "boolean",
            "enum",
            "json",
            "model",
            "file",
            "catalog"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "ModelIdRules": {
      "description": "The model-id rule the console mirrors (docs/v4/CUSTOM-MODELS.md D-V4-23, R-V4-21).\n\nDefaults are the contracts' own constants, so ``ModelIdRules()`` is the\nlive rule. ``pattern`` is the syntax rule as a JS-compatible regex; a value\nstarting with one of ``secret_prefixes``, or a bare token of at least\n``bare_token_min_len`` characters of one class with no ``/ . : -``, is\nrefused as a secret first.",
      "properties": {
        "bare_token_min_len": {
          "default": 32,
          "title": "Bare Token Min Len",
          "type": "integer"
        },
        "max_len": {
          "default": 200,
          "title": "Max Len",
          "type": "integer"
        },
        "pattern": {
          "default": "^(?![Hh][Tt][Tt][Pp])(?!.*://)[!$%()*+,\\-./0-9:;@A-Z\\[\\\\\\]^_a-z{|}~]{1,200}$",
          "title": "Pattern",
          "type": "string"
        },
        "secret_prefixes": {
          "items": {
            "type": "string"
          },
          "title": "Secret Prefixes",
          "type": "array"
        }
      },
      "title": "ModelIdRules",
      "type": "object"
    },
    "ModelSpec": {
      "description": "A suggested model id for a provider (a suggestion list, never an allowlist).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "supports_video": {
          "default": false,
          "description": "Accepts visual input: video frames for realtime models, image content parts for LLMs. Set only after the platform has verified it.",
          "title": "Supports Video",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "PageSpec": {
      "description": "How to follow a vendor list's pages (D-V4-25).\n\n* ``token`` / ``cursor``: send ``param=<value at next_path>`` until the\n  value is missing or empty (Gemini ``pageToken``/``nextPageToken``,\n  Anthropic ``after_id``/``last_id``, Cartesia ``starting_after``/``next_page``).\n* ``offset``: send ``param=<items so far>`` until a short or empty page.\n* ``page``: send ``param=<n>`` from 0 (``page_number``), stopping at the\n  total page count read from ``next_path`` or at an empty page (Hume).\n\n``more_path`` (optional) names a boolean such as ``has_more``; ``false``\nstops the loop before another request. ``size_param=size`` rides on\nevery request. The loop never exceeds ``max_pages``.",
      "properties": {
        "kind": {
          "enum": [
            "cursor",
            "token",
            "offset",
            "page"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_pages": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "more_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "More Path"
        },
        "next_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Path"
        },
        "param": {
          "title": "Param",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "size_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Param"
        }
      },
      "required": [
        "kind",
        "param"
      ],
      "title": "PageSpec",
      "type": "object"
    },
    "ProviderCapabilities": {
      "description": "What a provider can do, used to gate UI affordances and runtime behaviour.",
      "properties": {
        "audio_input": {
          "default": true,
          "title": "Audio Input",
          "type": "boolean"
        },
        "cloud_only": {
          "default": false,
          "title": "Cloud Only",
          "type": "boolean"
        },
        "languages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "platforms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        },
        "silent_tool_reply": {
          "default": false,
          "title": "Silent Tool Reply",
          "type": "boolean"
        },
        "text_modality": {
          "default": false,
          "title": "Text Modality",
          "type": "boolean"
        },
        "tool_calling": {
          "default": true,
          "title": "Tool Calling",
          "type": "boolean"
        },
        "video_input": {
          "default": false,
          "title": "Video Input",
          "type": "boolean"
        },
        "vision": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vision"
        },
        "voices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Voices",
          "type": "array"
        },
        "voices_dynamic": {
          "default": false,
          "title": "Voices Dynamic",
          "type": "boolean"
        }
      },
      "title": "ProviderCapabilities",
      "type": "object"
    },
    "ProviderOut": {
      "description": "A registry entry plus this workspace's settings (``GET /v1/providers``).",
      "properties": {
        "availability": {
          "default": "available",
          "enum": [
            "available",
            "deferred",
            "incompatible",
            "removed"
          ],
          "title": "Availability",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderCapabilities",
          "default": {
            "audio_input": true,
            "cloud_only": false,
            "languages": [],
            "platforms": [],
            "silent_tool_reply": false,
            "text_modality": false,
            "tool_calling": true,
            "video_input": false,
            "vision": null,
            "voices": [],
            "voices_dynamic": false
          }
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "credential_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The registry id whose credential rows this provider uses (its credential home, R-V4-7). Unset means the provider is its own home. The home exists, has no home of its own and declares the same secret field names.",
          "title": "Credential Provider"
        },
        "default_credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Credential Id"
        },
        "default_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Model"
        },
        "docs_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docs Url"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Fields",
          "type": "array"
        },
        "get_key_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Get Key Url"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "installed_on": {
          "items": {
            "type": "string"
          },
          "title": "Installed On",
          "type": "array"
        },
        "kind": {
          "enum": [
            "realtime",
            "stt",
            "llm",
            "tts",
            "avatar",
            "vad",
            "turn_detection",
            "noise_cancellation",
            "image_gen",
            "embedding",
            "secret_bag"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "models": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelSpec"
          },
          "title": "Models",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "price_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Ref"
        },
        "probe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The api's 'Test model' probe adapter for this entry (docs/v4/CUSTOM-MODELS.md D-V4-26): a capped POST with a payload, deliberately separate from `test` (a GET that lists). Unset means no model test; never set on vad, turn_detection or noise_cancellation.",
          "title": "Probe"
        },
        "python_class": {
          "title": "Python Class",
          "type": "string"
        },
        "requires_credential": {
          "default": true,
          "title": "Requires Credential",
          "type": "boolean"
        },
        "secret_fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Secret Fields",
          "type": "array"
        },
        "status": {
          "default": "mvp",
          "enum": [
            "mvp",
            "deferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test"
        },
        "v": {
          "default": 2,
          "enum": [
            1,
            2
          ],
          "title": "V",
          "type": "integer"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        },
        "verification": {
          "default": "unverified",
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "verified_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Note"
        },
        "worker_image": {
          "default": "full",
          "enum": [
            "slim",
            "full",
            "isolated"
          ],
          "title": "Worker Image",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "vendor",
        "package",
        "python_class"
      ],
      "title": "ProviderOut",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ProvidersResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /v1/providers``.\n\n``v=2`` (V2-06): ``providers`` carries the enriched :class:`ProviderOut`\n(a superset of ``ProviderSpec`` with this workspace's ``enabled``,\n``installed_on`` and ``default_credential_id``), not the bare registry\nentry.\n\n``model_id_rules`` (V4-07, additive): the model-id rule for the console;\nfilled by ``GET /v1/providers`` and by the ``providers.json`` export.",
  "properties": {
    "model_id_rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelIdRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/ProviderOut"
      },
      "title": "Providers",
      "type": "array"
    },
    "v": {
      "default": 2,
      "enum": [
        1,
        2
      ],
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "providers"
  ],
  "title": "ProvidersResponse",
  "type": "object"
}
