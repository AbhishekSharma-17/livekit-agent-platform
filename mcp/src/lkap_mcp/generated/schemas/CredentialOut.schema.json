{
  "$id": "lkap-contracts/CredentialOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A stored credential, without any secret material.\n\nV6-32: the last key test (every ``POST /v1/credentials/{id}/test`` is\nrecorded, including the one run right after adding the key) and when a\nsession, a tool call, a catalog read or a knowledge-base embed last used\nthe key. All four are ``None`` until it happens.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "last_test_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Test At"
    },
    "last_test_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Test Message"
    },
    "last_test_ok": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "`true` the key worked, `false` it failed, `null` untested or the provider has no automatic test",
      "title": "Last Test Ok"
    },
    "last_used_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When a session, tool call, catalog read or embed last used the key (to within a minute)",
      "title": "Last Used At"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "provider_id",
    "label",
    "fingerprint",
    "created_at",
    "updated_at"
  ],
  "title": "CredentialOut",
  "type": "object"
}
