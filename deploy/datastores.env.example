# V6-37: settings for deploy/docker-compose.datastores.yml (docs/RUNBOOK.md §9.10).
# Copy it outside the repo, chmod 600, fill it in, and pass it with --env-file.
# Placeholders only. Never commit the filled-in copy.

# The Postgres password of the `lkap` user. Use URL-safe characters (letters, digits,
# - _ . ~) because it also goes into the api's LKAP_DATABASE_URL.
LKAP_PG_PASSWORD=

# Host ports, published on 127.0.0.1 only. Pick ports nothing else on the host uses
# (a LiveKit stack often has its own Redis on 6379 already).
LKAP_PG_PORT=5433
LKAP_VALKEY_PORT=6380
LKAP_SEAWEEDFS_S3_PORT=8333

# The SeaweedFS volume server's port inside its container. Its default, 8080, is the
# api's port, so keep it on something else.
LKAP_SEAWEEDFS_VOLUME_PORT=18080

# Pin a SeaweedFS release here (chrislusf/seaweedfs:<version>).
LKAP_SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
