{
  "$id": "lkap-contracts/AnalyticsDriver.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One of the range's top cost drivers (``session_costs`` lines grouped by provider, model and unit).\n\nWhen the top drivers do not cover the range's total, one synthetic row\n``provider_id=\"other\"`` (no model, no unit) carries the remainder (R-V4-62).",
  "properties": {
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Cost Usd"
    },
    "estimated_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Usd"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "provider_id": {
      "description": "A registry id, or \"other\" for the synthetic remainder row.",
      "title": "Provider Id",
      "type": "string"
    },
    "share_pct": {
      "description": "This row's share of the range's total actual cost (every row sums to 100).",
      "title": "Share Pct",
      "type": "number"
    },
    "unit": {
      "anyOf": [
        {
          "enum": [
            "tokens_in",
            "tokens_out",
            "audio_s_in",
            "audio_s_out",
            "chars",
            "minutes",
            "images",
            "text_tokens_in",
            "text_tokens_out",
            "audio_tokens_in",
            "audio_tokens_out",
            "cached_tokens_in",
            "requests"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null only on the synthetic \"other\" row.",
      "title": "Unit"
    }
  },
  "required": [
    "provider_id",
    "cost_usd",
    "share_pct"
  ],
  "title": "AnalyticsDriver",
  "type": "object"
}
