{
  "$defs": {
    "ActivityEvent": {
      "description": "A tool call, workflow run or escalation rendered as a \"team feed\" entry.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "phase": {
          "enum": [
            "running",
            "done",
            "error",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "urgent": {
          "default": false,
          "title": "Urgent",
          "type": "boolean"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "ts",
        "source",
        "label",
        "phase",
        "headline"
      ],
      "title": "ActivityEvent",
      "type": "object"
    },
    "AssetRef": {
      "description": "Points at bytes already delivered on the ``lkap.ui.asset`` byte stream.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "meta": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Meta",
          "type": "object"
        },
        "mime": {
          "title": "Mime",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "mime",
        "ts"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ChecklistItem": {
      "description": "One \"still needed\" item.",
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "CostDriver": {
      "description": "One estimate-vs-actual comparison row; a list is sorted by ``|delta_usd|``, largest first.",
      "properties": {
        "actual_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Quantity"
        },
        "actual_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Usd"
        },
        "delta_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "actual - estimated; null when either side is unpriced.",
          "title": "Delta Usd"
        },
        "estimated_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Quantity"
        },
        "estimated_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "more minutes",
            "fewer minutes",
            "more talk",
            "less talk",
            "longer prompts",
            "more turns",
            "unpriced line",
            "price changed",
            "not estimated",
            "as estimated"
          ],
          "title": "Reason",
          "type": "string"
        },
        "slot": {
          "enum": [
            "stt",
            "llm",
            "tts",
            "realtime",
            "avatar",
            "workflow_llm",
            "image_gen",
            "embedding",
            "turn_detection",
            "vad",
            "livekit_agent",
            "livekit_participant",
            "livekit_sip",
            "livekit_egress",
            "qa_judge"
          ],
          "title": "Slot",
          "type": "string"
        },
        "unit": {
          "enum": [
            "tokens_in",
            "tokens_out",
            "audio_s_in",
            "audio_s_out",
            "chars",
            "minutes",
            "images",
            "text_tokens_in",
            "text_tokens_out",
            "audio_tokens_in",
            "audio_tokens_out",
            "cached_tokens_in",
            "requests"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "provider_id",
        "unit",
        "reason"
      ],
      "title": "CostDriver",
      "type": "object"
    },
    "CostLine": {
      "description": "One priced usage line of a session.\n\n``cost_usd`` is ``None`` with ``note=\"no price\"`` when the price table has\nno entry — an unknown price is never reported as zero.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "price_source": {
          "anyOf": [
            {
              "enum": [
                "workspace",
                "live",
                "table"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which price source priced the line (null when unpriced).",
          "title": "Price Source"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "enum": [
            "tokens_in",
            "tokens_out",
            "audio_s_in",
            "audio_s_out",
            "chars",
            "minutes",
            "images",
            "text_tokens_in",
            "text_tokens_out",
            "audio_tokens_in",
            "audio_tokens_out",
            "cached_tokens_in",
            "requests"
          ],
          "title": "Unit",
          "type": "string"
        },
        "unit_price_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price Usd"
        },
        "vendor_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What was reconciled, e.g. \"12 generations\".",
          "title": "Vendor Ref"
        },
        "vendor_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vendor's own charge for this line, when reconciled.",
          "title": "Vendor Usd"
        }
      },
      "required": [
        "provider_id",
        "unit",
        "quantity"
      ],
      "title": "CostLine",
      "type": "object"
    },
    "Note": {
      "description": "A line in the panel's notes list. A repeated ``key`` upserts in place.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
