{
  "$defs": {
    "ErrorBody": {
      "description": "The body of an LKAP error response.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ErrorResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Envelope for all 4xx/5xx responses.",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
