{
  "$id": "lkap-contracts/KbOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A knowledge base with its current counts.",
  "properties": {
    "chunk_count": {
      "title": "Chunk Count",
      "type": "integer"
    },
    "chunking": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "`{max_tokens, overlap}` of the chunker; null means the defaults.",
      "title": "Chunking"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "dimension": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Vector width recorded at creation; null for a KB created before V5-01.",
      "title": "Dimension"
    },
    "document_count": {
      "title": "Document Count",
      "type": "integer"
    },
    "embedder_id": {
      "title": "Embedder Id",
      "type": "string"
    },
    "embedder_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Embedding model recorded at creation; null for a KB created before V5-01.",
      "title": "Embedder Model"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "embedder_id",
    "chunk_count",
    "document_count",
    "created_at",
    "updated_at"
  ],
  "title": "KbOut",
  "type": "object"
}
