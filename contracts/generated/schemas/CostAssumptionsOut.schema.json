{
  "$defs": {
    "Assumption": {
      "description": "One named input of the usage model (docs/v4/COSTS.md D-V4-41).",
      "properties": {
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "source": {
          "enum": [
            "default",
            "workspace",
            "request"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value",
        "source",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/CostAssumptionsOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /v1/cost-estimates/assumptions``: the workspace's effective assumptions.",
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "sessions_sampled": {
      "default": 0,
      "description": "Ended sessions the workspace averages came from.",
      "title": "Sessions Sampled",
      "type": "integer"
    }
  },
  "required": [
    "assumptions"
  ],
  "title": "CostAssumptionsOut",
  "type": "object"
}
