{
  "$defs": {
    "HttpToolDefinition": {
      "description": "An HTTP call exposed to the model as a raw-schema function tool.",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "body_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Template"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/ToolExecution"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "http",
          "default": "http",
          "title": "Kind",
          "type": "string"
        },
        "max_result_chars": {
          "default": 4000,
          "title": "Max Result Chars",
          "type": "integer"
        },
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Path"
        },
        "silent_reply": {
          "default": false,
          "title": "Silent Reply",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 10,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "parameters",
        "url"
      ],
      "title": "HttpToolDefinition",
      "type": "object"
    },
    "McpServerDefinition": {
      "description": "A streamable-HTTP MCP server attached to the agent.",
      "properties": {
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "mcp",
          "default": "mcp",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sse_read_timeout_s": {
          "default": 300,
          "title": "Sse Read Timeout S",
          "type": "number"
        },
        "timeout_s": {
          "default": 5,
          "title": "Timeout S",
          "type": "number"
        },
        "tool_options": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolExecution"
          },
          "default": {},
          "title": "Tool Options",
          "type": "object"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "McpServerDefinition",
      "type": "object"
    },
    "ToolExecution": {
      "description": "How one tool runs relative to the conversation (BACKGROUND-TOOLS.md §2).\n\nThe agent-level default (``ToolsConfig.execution_default``) only ever reaches read\ntools: GET HTTP tools and the built-ins in :data:`BACKGROUNDABLE_BUILTINS`. The\ntools in :data:`NEVER_BACKGROUND_TOOLS` and the flow edge tools always block.",
      "properties": {
        "announce": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announce"
        },
        "auto_threshold_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 0,
          "title": "Auto Threshold Ms",
          "type": "integer"
        },
        "cancellable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancellable"
        },
        "duplicate_scope": {
          "default": "name_and_args",
          "enum": [
            "name",
            "name_and_args"
          ],
          "title": "Duplicate Scope",
          "type": "string"
        },
        "filler_delay_s": {
          "default": 4.0,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Filler Delay S",
          "type": "number"
        },
        "filler_interval_s": {
          "default": 8.0,
          "maximum": 60,
          "minimum": 1,
          "title": "Filler Interval S",
          "type": "number"
        },
        "fillers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Fillers",
          "type": "array"
        },
        "max_duration_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Max Duration S",
          "type": "number"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "blocking",
                "background",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "on_duplicate": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "reject",
                "replace",
                "confirm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Duplicate"
        },
        "report_progress": {
          "default": false,
          "title": "Report Progress",
          "type": "boolean"
        }
      },
      "title": "ToolExecution",
      "type": "object"
    },
    "ToolOut": {
      "description": "A stored tool row.",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "definition": {
          "discriminator": {
            "mapping": {
              "http": "#/$defs/HttpToolDefinition",
              "mcp": "#/$defs/McpServerDefinition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HttpToolDefinition"
            },
            {
              "$ref": "#/$defs/McpServerDefinition"
            }
          ],
          "title": "Definition"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "http",
            "mcp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "definition",
        "id",
        "created_at",
        "updated_at"
      ],
      "title": "ToolOut",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ToolPage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ToolOut"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "ToolPage",
  "type": "object"
}
