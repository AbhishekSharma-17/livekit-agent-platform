{
  "$id": "lkap-contracts/TrunkOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A SIP trunk as stored by the platform, with its LiveKit id (never its password).",
  "properties": {
    "address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Address"
    },
    "auth_username": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auth Username"
    },
    "connection_id": {
      "title": "Connection Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "direction": {
      "enum": [
        "inbound",
        "outbound"
      ],
      "title": "Direction",
      "type": "string"
    },
    "has_password": {
      "default": false,
      "title": "Has Password",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lk_trunk_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lk Trunk Id"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "numbers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Numbers",
      "type": "array"
    },
    "provider_hint": {
      "default": "other",
      "enum": [
        "twilio",
        "telnyx",
        "other"
      ],
      "title": "Provider Hint",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "connection_id",
    "direction",
    "name",
    "created_at",
    "updated_at"
  ],
  "title": "TrunkOut",
  "type": "object"
}
