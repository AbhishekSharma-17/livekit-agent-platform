{
  "$id": "lkap-contracts/ErrorBody.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The body of an LKAP error response.",
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "details": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "message": {
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorBody",
  "type": "object"
}
