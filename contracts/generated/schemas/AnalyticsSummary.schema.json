{
  "$defs": {
    "AnalyticsBucket": {
      "description": "One day or one agent in ``AnalyticsSummary``.",
      "properties": {
        "accuracy_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "actual / estimated x 100 over the sessions that have both figures.",
          "title": "Accuracy Pct"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "estimated_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Usd"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "minutes": {
          "default": 0.0,
          "title": "Minutes",
          "type": "number"
        },
        "sessions": {
          "default": 0,
          "title": "Sessions",
          "type": "integer"
        },
        "sessions_estimated": {
          "default": 0,
          "title": "Sessions Estimated",
          "type": "integer"
        }
      },
      "required": [
        "key"
      ],
      "title": "AnalyticsBucket",
      "type": "object"
    },
    "AnalyticsDriver": {
      "description": "One of the range's top cost drivers (``session_costs`` lines grouped by provider, model and unit).\n\nWhen the top drivers do not cover the range's total, one synthetic row\n``provider_id=\"other\"`` (no model, no unit) carries the remainder (R-V4-62).",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cost Usd"
        },
        "estimated_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider_id": {
          "description": "A registry id, or \"other\" for the synthetic remainder row.",
          "title": "Provider Id",
          "type": "string"
        },
        "share_pct": {
          "description": "This row's share of the range's total actual cost (every row sums to 100).",
          "title": "Share Pct",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "tokens_in",
                "tokens_out",
                "audio_s_in",
                "audio_s_out",
                "chars",
                "minutes",
                "images",
                "text_tokens_in",
                "text_tokens_out",
                "audio_tokens_in",
                "audio_tokens_out",
                "cached_tokens_in",
                "requests"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null only on the synthetic \"other\" row.",
          "title": "Unit"
        }
      },
      "required": [
        "provider_id",
        "cost_usd",
        "share_pct"
      ],
      "title": "AnalyticsDriver",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/AnalyticsSummary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /v1/analytics/summary``.",
  "properties": {
    "accuracy_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "actual / estimated x 100 over the sessions that have both figures.",
      "title": "Accuracy Pct"
    },
    "by_agent": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalyticsBucket"
      },
      "title": "By Agent",
      "type": "array"
    },
    "by_day": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalyticsBucket"
      },
      "title": "By Day",
      "type": "array"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "estimated_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Usd"
    },
    "failed": {
      "default": 0,
      "title": "Failed",
      "type": "integer"
    },
    "minutes": {
      "default": 0.0,
      "title": "Minutes",
      "type": "number"
    },
    "sessions": {
      "default": 0,
      "title": "Sessions",
      "type": "integer"
    },
    "sessions_estimated": {
      "default": 0,
      "title": "Sessions Estimated",
      "type": "integer"
    },
    "top_drivers": {
      "default": [],
      "description": "At most 8, largest first, then an \"other\" row when they do not cover the total.",
      "items": {
        "$ref": "#/$defs/AnalyticsDriver"
      },
      "title": "Top Drivers",
      "type": "array"
    }
  },
  "title": "AnalyticsSummary",
  "type": "object"
}
