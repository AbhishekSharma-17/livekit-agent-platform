{
  "$defs": {
    "AgentPublicOut": {
      "description": "What an unauthenticated browser may see about a published agent.\n\n``panel`` (R-V2-7, CONTRACTS-V2 §4.4 \"Layout delivery\") is the\n*effective* layout — ``lkap_api.panels.effective_layout(agent, pack)`` —\nnot necessarily ``AgentConfig.panel`` verbatim: it carries the block list\nthe session actually renders, resolved the same way for ``connect`` and\nfor the worker's ``/internal/v1/sessions/{id}/resolved``. ``ui_panel_id``\nstays as the mirror of ``panel.panel_id`` for one release.",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/CapabilitiesConfig"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "panel": {
          "$ref": "#/$defs/PanelLayout"
        },
        "pipeline_mode": {
          "enum": [
            "realtime",
            "cascaded",
            "half_cascade"
          ],
          "title": "Pipeline Mode",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "ui_panel_id": {
          "title": "Ui Panel Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "ui_panel_id",
        "panel",
        "capabilities",
        "pipeline_mode"
      ],
      "title": "AgentPublicOut",
      "type": "object"
    },
    "BlockSpec": {
      "description": "One block of a composite panel (CONTRACTS-V2 §4.4).\n\n``id`` keys the block's state in :attr:`UiState.blocks`; ``config`` is\nblock-type specific and rendered by the matching React component.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "default": {},
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "enum": [
            "status",
            "notes",
            "checklist",
            "activity",
            "form",
            "document",
            "gallery",
            "table",
            "transcript",
            "video",
            "kb_citations",
            "custom"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "BlockSpec",
      "type": "object"
    },
    "CapabilitiesConfig": {
      "description": "Which input affordances the session page offers.",
      "properties": {
        "camera": {
          "default": false,
          "title": "Camera",
          "type": "boolean"
        },
        "chat_input": {
          "default": true,
          "title": "Chat Input",
          "type": "boolean"
        },
        "dtmf": {
          "default": false,
          "title": "Dtmf",
          "type": "boolean"
        },
        "screen_share": {
          "default": false,
          "title": "Screen Share",
          "type": "boolean"
        },
        "vision_inject_per_turn": {
          "default": true,
          "title": "Vision Inject Per Turn",
          "type": "boolean"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    },
    "PanelLayout": {
      "description": "Which panel renders the session, and (for ``composite``) its blocks.",
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockSpec"
          },
          "title": "Blocks",
          "type": "array"
        },
        "layout": {
          "default": "side",
          "enum": [
            "side",
            "wide"
          ],
          "title": "Layout",
          "type": "string"
        },
        "panel_id": {
          "default": "composite",
          "title": "Panel Id",
          "type": "string"
        }
      },
      "title": "PanelLayout",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ConnectResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "LiveKit ``TokenSourceResponse``-compatible connection details (camelCase).",
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentPublicOut"
    },
    "participantName": {
      "title": "Participantname",
      "type": "string"
    },
    "participantToken": {
      "title": "Participanttoken",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "default": 1,
      "title": "Protocolversion",
      "type": "integer"
    },
    "roomName": {
      "title": "Roomname",
      "type": "string"
    },
    "serverUrl": {
      "title": "Serverurl",
      "type": "string"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "uiPanelId": {
      "title": "Uipanelid",
      "type": "string"
    }
  },
  "required": [
    "serverUrl",
    "participantToken",
    "roomName",
    "participantName",
    "sessionId",
    "agent",
    "uiPanelId"
  ],
  "title": "ConnectResponse",
  "type": "object"
}
