              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "McpToolSnapshot",
      "type": "object"
    },
    "ProviderToolDefinition": {
      "description": "One action of a connected app run through a tool provider (docs/v5/COMPOSIO.md §3, D-V5-C8).\n\nCreated by materialisation (``POST /v1/tool-providers/composio/materialise``): the\nparameters are pinned from the provider's schema at import, the description is its first\nsentence (editable). The worker runs it with ``POST /api/v3.1/tools/execute/{tool_slug}``\non the provider's host. ``headers`` carry the provider key as a ``{{ secret.NAME }}``\nplaceholder that the api substitutes from ``credential_id`` when a session resolves, as\nfor HTTP tools; ``connection_id`` is the connected-app row, ``subject`` the provider's\n``user_id`` copied from it.",
      "properties": {
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "confirm_readback": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Confirm Readback",
          "type": "array"
        },
        "connected_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connected Account Id"
        },
        "connection_id": {
          "title": "Connection Id",
          "type": "string"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/ToolExecution"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "provider",
          "default": "provider",
          "title": "Kind",
          "type": "string"
        },
        "max_result_chars": {
          "default": 1500,
          "maximum": 20000,
          "minimum": 100,
          "title": "Max Result Chars",
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "pinned_arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "maxProperties": 20,
          "title": "Pinned Arguments",
          "type": "object"
        },
        "provider": {
          "const": "composio",
          "default": "composio",
          "title": "Provider",
          "type": "string"
        },
        "requires_vars": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires Vars",
          "type": "array"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "data",
          "title": "Result Path"
        },
        "risk": {
          "default": "write",
          "enum": [
            "read",
            "write",
            "destructive"
          ],
          "title": "Risk",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "silent_reply": {
          "default": false,
          "title": "Silent Reply",
