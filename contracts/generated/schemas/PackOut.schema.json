{
  "$defs": {
    "AvatarOptions": {
      "description": "Publisher-side options applied to whichever avatar plugin is selected.",
      "properties": {
        "idle_timeout_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Timeout S"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "participant_name": {
          "default": "Avatar",
          "title": "Participant Name",
          "type": "string"
        },
        "video_quality": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "very_high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Quality"
        }
      },
      "title": "AvatarOptions",
      "type": "object"
    },
    "BlockSpec": {
      "description": "One block of a composite panel (CONTRACTS-V2 §4.4).\n\n``id`` keys the block's state in :attr:`UiState.blocks`; ``config`` is\nblock-type specific and rendered by the matching React component.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "default": {},
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "enum": [
            "status",
            "notes",
            "checklist",
            "activity",
            "form",
            "document",
            "gallery",
            "table",
            "transcript",
            "video",
            "kb_citations",
            "custom"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "BlockSpec",
      "type": "object"
    },
    "CapabilitiesConfig": {
      "description": "Which input affordances the session page offers.",
      "properties": {
        "camera": {
          "default": false,
          "title": "Camera",
          "type": "boolean"
        },
        "chat_input": {
          "default": true,
          "title": "Chat Input",
          "type": "boolean"
        },
        "dtmf": {
          "default": false,
          "title": "Dtmf",
          "type": "boolean"
        },
        "screen_share": {
          "default": false,
          "title": "Screen Share",
          "type": "boolean"
        },
        "vision_inject_per_turn": {
          "default": true,
          "title": "Vision Inject Per Turn",
          "type": "boolean"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    },
    "KbSeed": {
      "description": "A knowledge base the api creates when seeding an agent from this pack.",
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "kb_name": {
          "title": "Kb Name",
          "type": "string"
        }
      },
      "required": [
        "kb_name",
        "files"
      ],
      "title": "KbSeed",
      "type": "object"
    },
    "PackManifest": {
      "description": "Everything the api and console need to know about a pack.",
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockSpec"
          },
          "title": "Blocks",
          "type": "array"
        },
        "builtin_tools_disabled": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Builtin Tools Disabled",
          "type": "array"
        },
        "capabilities": {
          "$ref": "#/$defs/CapabilitiesConfig"
        },
        "default_greeting": {
          "title": "Default Greeting",
          "type": "string"
        },
        "default_instructions": {
          "title": "Default Instructions",
          "type": "string"
        },
        "default_panel": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_voice": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Default Voice",
          "type": "object"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "instructions_by_mode": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "realtime",
              "cascaded",
              "half_cascade"
            ]
          },
          "title": "Instructions By Mode",
          "type": "object"
        },
        "kb_seeds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KbSeed"
          },
          "title": "Kb Seeds",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "recommended_pipeline": {
          "$ref": "#/$defs/PipelineConfig"
        },
        "settings_schema": {
          "additionalProperties": true,
          "default": {
            "type": "object"
          },
          "title": "Settings Schema",
          "type": "object"
        },
        "state_schema": {
          "additionalProperties": true,
          "title": "State Schema",
          "type": "object"
        },
        "tool_names": {
          "items": {
            "type": "string"
          },
          "title": "Tool Names",
          "type": "array"
        },
        "ui_panel_id": {
          "title": "Ui Panel Id",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "description",
        "ui_panel_id",
        "default_instructions",
        "default_greeting",
        "recommended_pipeline",
        "capabilities",
        "tool_names",
        "state_schema"
      ],
      "title": "PackManifest",
      "type": "object"
    },
    "PanelLayout": {
      "description": "Which panel renders the session, and (for ``composite``) its blocks.",
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockSpec"
          },
          "title": "Blocks",
          "type": "array"
        },
        "layout": {
          "default": "side",
          "enum": [
            "side",
            "wide"
          ],
          "title": "Layout",
          "type": "string"
        },
        "panel_id": {
          "default": "composite",
          "title": "Panel Id",
          "type": "string"
        }
      },
      "title": "PanelLayout",
      "type": "object"
    },
    "PipelineConfig": {
      "description": "Which providers fill which slot, and how turns are handled.\n\nSlot requirements per mode are reported by :func:`pipeline_issues` rather\nthan raised here: the api returns them as a ``ValidationResult`` so a\nhalf-finished pipeline can still be saved as a draft.",
      "properties": {
        "avatar": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avatar_options": {
          "$ref": "#/$defs/AvatarOptions",
          "default": {
            "idle_timeout_s": null,
            "max_duration_s": null,
            "participant_name": "Avatar",
            "video_quality": null
          }
        },
        "image_gen": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "cascaded",
          "enum": [
            "realtime",
            "cascaded",
            "half_cascade"
          ],
          "title": "Mode",
          "type": "string"
        },
        "noise_cancellation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "realtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_detection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_handling": {
          "additionalProperties": true,
          "default": {},
          "title": "Turn Handling",
          "type": "object"
        },
        "vad": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflow_llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "ProviderRef": {
      "description": "Points at a registry provider plus the credential and options to use.",
      "properties": {
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Fields",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "ProviderRef",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/PackOut.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One discovered pack.",
  "properties": {
    "manifest": {
      "$ref": "#/$defs/PackManifest"
    }
  },
  "required": [
    "manifest"
  ],
  "title": "PackOut",
  "type": "object"
}
