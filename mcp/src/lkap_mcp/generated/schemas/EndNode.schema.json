{
  "$id": "lkap-contracts/EndNode.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Terminal node: says farewell, records a disposition and ends the session.",
  "properties": {
    "disposition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition"
    },
    "farewell": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Farewell"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "end",
      "default": "end",
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "default": "",
      "title": "Label",
      "type": "string"
    },
    "position": {
      "default": [
        0.0,
        0.0
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Position",
      "type": "array"
    },
    "webhook_event": {
      "default": true,
      "title": "Webhook Event",
      "type": "boolean"
    }
  },
  "required": [
    "id"
  ],
  "title": "EndNode",
  "type": "object"
}
