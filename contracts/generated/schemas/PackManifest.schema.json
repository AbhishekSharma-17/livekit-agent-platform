{
  "$defs": {
    "CapabilitiesConfig": {
      "description": "Which input affordances the session page offers.",
      "properties": {
        "camera": {
          "default": false,
          "title": "Camera",
          "type": "boolean"
        },
        "chat_input": {
          "default": true,
          "title": "Chat Input",
          "type": "boolean"
        },
        "screen_share": {
          "default": false,
          "title": "Screen Share",
          "type": "boolean"
        },
        "vision_inject_per_turn": {
          "default": true,
          "title": "Vision Inject Per Turn",
          "type": "boolean"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    },
    "KbSeed": {
      "description": "A knowledge base the api creates when seeding an agent from this pack.",
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "kb_name": {
          "title": "Kb Name",
          "type": "string"
        }
      },
      "required": [
        "kb_name",
        "files"
      ],
      "title": "KbSeed",
      "type": "object"
    },
    "PipelineConfig": {
      "description": "Which providers fill which slot, and how turns are handled.",
      "properties": {
        "avatar": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_gen": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "cascaded",
          "enum": [
            "realtime",
            "cascaded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "realtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_handling": {
          "additionalProperties": true,
          "default": {},
          "title": "Turn Handling",
          "type": "object"
        },
        "workflow_llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "ProviderRef": {
      "description": "Points at a registry provider plus the credential and options to use.",
      "properties": {
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Fields",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "ProviderRef",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/PackManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Everything the api and console need to know about a pack.",
  "properties": {
    "builtin_tools_disabled": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Builtin Tools Disabled",
      "type": "array"
    },
    "capabilities": {
      "$ref": "#/$defs/CapabilitiesConfig"
    },
    "default_greeting": {
      "title": "Default Greeting",
      "type": "string"
    },
    "default_instructions": {
      "title": "Default Instructions",
      "type": "string"
    },
    "default_voice": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Default Voice",
      "type": "object"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "instructions_by_mode": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "propertyNames": {
        "enum": [
          "realtime",
          "cascaded"
        ]
      },
      "title": "Instructions By Mode",
      "type": "object"
    },
    "kb_seeds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KbSeed"
      },
      "title": "Kb Seeds",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "recommended_pipeline": {
      "$ref": "#/$defs/PipelineConfig"
    },
    "settings_schema": {
      "additionalProperties": true,
      "default": {
        "type": "object"
      },
      "title": "Settings Schema",
      "type": "object"
    },
    "state_schema": {
      "additionalProperties": true,
      "title": "State Schema",
      "type": "object"
    },
    "tool_names": {
      "items": {
        "type": "string"
      },
      "title": "Tool Names",
      "type": "array"
    },
    "ui_panel_id": {
      "title": "Ui Panel Id",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "description",
    "ui_panel_id",
    "default_instructions",
    "default_greeting",
    "recommended_pipeline",
    "capabilities",
    "tool_names",
    "state_schema"
  ],
  "title": "PackManifest",
  "type": "object"
}
