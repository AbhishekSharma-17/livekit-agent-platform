# Copy to deploy/api.env (human-created; read by every compose file in this
# directory — v1 docker-compose.yml, v2 docker-compose.dev.yml, and v2
# docker-compose.prod.yml's `api`/`migrate`/`jobs` services all share it) and
# fill in real values. Never commit the copy.
# Field meanings: docs/CONTRACTS.md §3, docs/v2/CONTRACTS-V2.md §6. Generate
# LKAP_MASTER_KEY with:
#   cd api && uv run python -m lkap_api.keys generate

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LKAP_AGENT_NAME=lkap-agent
LKAP_MASTER_KEY=
LKAP_ADMIN_TOKEN=
LKAP_SERVICE_TOKEN=
LKAP_CORS_ORIGINS=http://localhost:3000
LKAP_PACKS=packs.insurance_claim,packs.generic
LKAP_EMBEDDER=fastembed
LKAP_LOG_LEVEL=INFO
# optional dev-only credential seed: {"google-realtime": {"api_key": "..."}}
LKAP_BOOTSTRAP_CREDENTIALS_JSON=

# --- v2 additions (CONTRACTS-V2 §6) -----------------------------------------
# ≥32 bytes, not a dev-* placeholder — required in LKAP_ENV=prod, signs
# cookie sessions and invite tokens (lkap_api.settings.Settings._enforce_production_secrets):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LKAP_SESSION_SECRET=
# First owner account (docs/v2/ARCHITECTURE-V2.md D-V2-6); leave the password
# unset in dev to have one generated and logged once at WARNING on first boot.
LKAP_BOOTSTRAP_OWNER_EMAIL=owner@local
LKAP_BOOTSTRAP_OWNER_PASSWORD=
# In LKAP_ENV=prod, break-glass X-Admin-Token defaults OFF — leave unset
# unless you explicitly need it (deploy/docker-compose.prod.yml does not set
# LKAP_ALLOW_ADMIN_TOKEN, so the prod default applies).
LKAP_ALLOW_ADMIN_TOKEN=

# LKAP_DATA_DIR and PORT are set in each compose file's `environment:` — do
# not override here unless you changed the volume/port mapping.
# LKAP_DATABASE_URL, LKAP_REDIS_URL, LKAP_JOBS_BACKEND, LKAP_STORAGE_*,
# LKAP_PUBLIC_BASE_URL and LKAP_WEB_BASE_URL are also set per compose file's
# `environment:` (dev: sqlite + local storage by default; prod: Postgres +
# Redis + MinIO, credentials in deploy/prod.env) — do not duplicate them here
# unless you are intentionally overriding a compose file's default.
