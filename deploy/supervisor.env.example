# Copy to deploy/supervisor.env (human-created; read by the `supervisor`
# service's `env_file:` in docker-compose.dev.yml and docker-compose.prod.yml)
# and fill in real values. Never commit the copy.
# Field meanings: docs/v2/CONTRACTS-V2.md §5, §6.

# Must match the same value configured on the api (LKAP_SERVICE_TOKEN in
# api.env) — this is how the supervisor authenticates to
# GET /internal/v1/fleet/desired and GET /internal/v1/connections/{id}/worker-env.
LKAP_SERVICE_TOKEN=

# LKAP_API_BASE_URL, LKAP_SUPERVISOR_BACKEND, LKAP_AGENT_IMAGE_SLIM/FULL and
# LKAP_SUPERVISOR_DOCKER_NETWORK are already set in each compose file's
# `environment:` — only override them here if you have a reason to.

# Tuning (defaults shown; CONTRACTS-V2 §6):
# LKAP_SUPERVISOR_INTERVAL_S=10
# LKAP_SUPERVISOR_DRAIN_S=3600
