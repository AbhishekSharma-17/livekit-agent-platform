{
  "$id": "lkap-contracts/DatasetColumn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One column of a dataset.",
  "properties": {
    "key": {
      "default": false,
      "title": "Key",
      "type": "boolean"
    },
    "label": {
      "maxLength": 200,
      "title": "Label",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z_][a-z0-9_]{0,63}$",
      "title": "Name",
      "type": "string"
    },
    "type": {
      "default": "string",
      "enum": [
        "string",
        "phone",
        "email",
        "number"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "name",
    "label"
  ],
  "title": "DatasetColumn",
  "type": "object"
}
