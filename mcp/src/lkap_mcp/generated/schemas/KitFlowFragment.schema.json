{
  "$defs": {
    "AgentNode": {
      "description": "One conversational step with its own instructions, tools and extractions.",
      "properties": {
        "allow_interruptions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Interruptions"
        },
        "extract": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Extract",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "instructions": {
          "default": "",
          "title": "Instructions",
          "type": "string"
        },
        "kb_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kb Ids",
          "type": "array"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "max_turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turns"
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/ProviderRef"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "llm",
              "tts"
            ]
          },
          "title": "Providers",
          "type": "object"
        },
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "AgentNode",
      "type": "object"
    },
    "EndNode": {
      "description": "Terminal node: says farewell, records a disposition and ends the session.",
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition"
        },
        "farewell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Farewell"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "end",
          "default": "end",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "webhook_event": {
          "default": true,
          "title": "Webhook Event",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "EndNode",
      "type": "object"
    },
    "FlowEdge": {
      "description": "A conditional transition; ``condition`` becomes the handoff tool description.",
      "properties": {
        "condition": {
          "default": "",
          "title": "Condition",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "transition_speech": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition Speech"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "FlowEdge",
      "type": "object"
    },
    "GlobalNode": {
      "description": "Instructions, tools and knowledge merged into every agent node.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "instructions": {
          "default": "",
          "title": "Instructions",
          "type": "string"
        },
        "kb_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kb Ids",
          "type": "array"
        },
        "kind": {
          "const": "global",
          "default": "global",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "GlobalNode",
      "type": "object"
    },
    "ProviderRef": {
      "description": "Points at a registry provider plus the credential and options to use.",
      "properties": {
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Fields",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "ProviderRef",
      "type": "object"
    },
    "QaNode": {
      "description": "Post-call scoring step; never part of the conversational graph.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "qa",
          "default": "qa",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "rubric_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Prompt"
        }
      },
      "required": [
        "id"
      ],
      "title": "QaNode",
      "type": "object"
    },
    "StartNode": {
      "description": "Entry point: greets the caller and hands off along its first matching edge.",
      "properties": {
        "greeting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Greeting"
        },
        "greeting_mode": {
          "default": "say",
          "enum": [
            "say",
            "generate"
          ],
          "title": "Greeting Mode",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "start",
          "default": "start",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "StartNode",
      "type": "object"
    },
    "ToolBinding": {
      "description": "Copy one part of a successful tool result onto the panel or into a variable (D-V6-23).\n\nApplied by the worker after a successful call (an HTTP 2xx, an app action that\nsucceeded, an MCP result that is not an error) and before the model's next turn, with\nno model involved. ``path`` points into the tool's result as the model would see it\n(after ``result_path``); ``\"\"`` is the whole result.",
      "properties": {
        "path": {
          "default": "",
          "maxLength": 256,
          "title": "Path",
          "type": "string"
        },
        "to": {
          "maxLength": 140,
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "title": "ToolBinding",
      "type": "object"
    },
    "ToolNode": {
      "description": "Call one of the agent's attached tools with no model turn, then branch on the outcome (D-V6-28).\n\nThe worker runs the tool the moment the step is entered (through the same execution path\nas a call the model makes: blocking, the same guardrails and fences), applies\n:attr:`bindings` to the result, and takes the edge :attr:`on` names for the outcome. The\nresult text itself never reaches the model: what the next steps need goes into variables\n(``var:<name>`` bindings), which a later step's instructions show fenced, or onto the panel.",
      "properties": {
        "arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "maxProperties": 20,
          "title": "Arguments",
          "type": "object"
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "tool",
          "default": "tool",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "mcp_tool": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Tool"
        },
        "on": {
          "$ref": "#/$defs/ToolNodeOutcomes",
          "default": {
            "empty": null,
            "error": null,
            "ok": null
          }
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "timeout_s": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Timeout S",
          "type": "number"
        },
        "tool": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool"
      ],
      "title": "ToolNode",
      "type": "object"
    },
    "ToolNodeOutcomes": {
      "additionalProperties": false,
      "description": "Which outgoing edge a ``tool`` node takes for each outcome (edge ids).",
      "properties": {
        "empty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empty"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ok": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ok"
        }
      },
      "title": "ToolNodeOutcomes",
      "type": "object"
    },
    "TransferNode": {
      "description": "Hands the call to a human or another number.",
      "properties": {
        "announce": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announce"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "transfer",
          "default": "transfer",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "mode": {
          "default": "cold",
          "enum": [
            "cold",
            "warm"
          ],
          "title": "Mode",
          "type": "string"
        },
        "position": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "to"
      ],
      "title": "TransferNode",
      "type": "object"
    },
    "VariableSpec": {
      "description": "One variable a flow extracts from the conversation.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "enum",
            "date",
            "phone",
            "email"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "VariableSpec",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/KitFlowFragment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Steps added to an agent's existing flow after one of its steps (:data:`KIT_FLOW_ANCHOR`).\n\nAdded only when the request names that step (``flow_anchor``) and the agent has a flow;\nan agent without a flow never becomes one.",
  "properties": {
    "anchor_extract": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Anchor Extract",
      "type": "array"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FlowEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "agent": "#/$defs/AgentNode",
            "end": "#/$defs/EndNode",
            "global": "#/$defs/GlobalNode",
            "qa": "#/$defs/QaNode",
            "start": "#/$defs/StartNode",
            "tool": "#/$defs/ToolNode",
            "transfer": "#/$defs/TransferNode"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StartNode"
          },
          {
            "$ref": "#/$defs/AgentNode"
          },
          {
            "$ref": "#/$defs/EndNode"
          },
          {
            "$ref": "#/$defs/GlobalNode"
          },
          {
            "$ref": "#/$defs/TransferNode"
          },
          {
            "$ref": "#/$defs/QaNode"
          },
          {
            "$ref": "#/$defs/ToolNode"
          }
        ]
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "variables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VariableSpec"
      },
      "title": "Variables",
      "type": "array"
    }
  },
  "required": [
    "nodes"
  ],
  "title": "KitFlowFragment",
  "type": "object"
}
