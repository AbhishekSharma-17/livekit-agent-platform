# Reverse proxy for deploy/docker-compose.prod.yml (PLAN-V2 §V2-09: "api ×2
# behind Caddy"). Caddy terminates TLS (automatic via ACME/Let's Encrypt for
# a real domain, or the internal CA for `LKAP_PUBLIC_DOMAIN=localhost`/an IP)
# and forwards to the `web`/`api` services over the compose-internal network.
#
# Set LKAP_PUBLIC_DOMAIN in the environment before `docker compose up`
# (see deploy/prod.env.example); Caddy reads it via `{$LKAP_PUBLIC_DOMAIN}`.
# For a bare-IP / no-DNS dev-prod smoke test, set it to `:80` and Caddy skips
# TLS entirely (documented below) rather than failing to obtain a cert.
#
# `/v1/*`, `/hooks/*` and `/internal/*` go straight to the api — these are
# the api's own public surface (agent connect/session endpoints, LiveKit/
# webhook receivers, and the internal worker API). Everything else goes to
# `web` (the console, session pages, the widget), which itself proxies
# `/api/console/*` to the api server-side
# (web/src/app/api/console/[...path]/route.ts) — that hop never touches
# Caddy, it is container-to-container inside `web`'s own outbound call.
#
# `/internal/*` is gated by source address (V2-22, ruling R-V2-27). The
# worker API is authenticated by ONE platform-wide service token, so it is
# reachable only from `LKAP_INTERNAL_ALLOWED_CIDRS`, which defaults to Caddy's
# `private_ranges` shortcut (RFC 1918, RFC 4193, loopback): workers on the
# compose network or a private LAN. Every other caller gets 403 from Caddy
# before the api sees the request. An operator whose workers call back over
# the internet (LiveKit Cloud-hosted agents, a worker on another network)
# lists their egress addresses, space-separated, e.g.
#   LKAP_INTERNAL_ALLOWED_CIDRS="10.0.0.0/8 203.0.113.7/32"
# Caddy substitutes `{$VAR}` into the file's bytes BEFORE tokenising it
# (caddyconfig/caddyfile/parse.go: `allTokens` = `Tokenize(replaceEnvVars(input))`),
# so a space-separated value becomes several `remote_ip` arguments. Keep
# `private_ranges` in the list if in-network workers still need access. The
# variable must not be set to an empty string (compose defaults it). Caddy is
# the only ingress in the prod compose, so `remote_ip` is the real peer; if a
# load balancer is ever put in front of Caddy, switch to `client_ip` with
# `trusted_proxies`, or every request will look like the balancer's address.
#
# api ×2 (`docker compose ... up --scale api=2`): `reverse_proxy api:8080`
# resolves the `api` service name via Docker's embedded DNS, which returns
# one A record per running replica; Caddy re-resolves on its own schedule.
# NOT verified here (no Docker daemon on this host) that Caddy actually
# load-balances across both — if it pins to the first-resolved address for
# the life of the process, restart Caddy after scaling, or add an explicit
# `reverse_proxy api-1:8080 api-2:8080` two-service pair instead. See the
# report for the exact caveat.
#
# `/mcp` is the remote MCP service (V3-06, docs/v3/AGENT-ACCESS.md §9.2,
# R-V3-15): Caddy terminates TLS and proxies `https://<domain>/mcp` unchanged
# to `mcp:8090/mcp` (never to the api; R-V3-4).
#   - `path /mcp /mcp/*` and not `/mcp*`, which would also match `/mcpfoo`.
#   - The `Host` header is passed through as sent (reverse_proxy's default), which
#     is what the service's Host check compares with LKAP_MCP_PUBLIC_URL.
#   - `request_body max_size 1MB` is the service's own body cap, enforced here
#     first (413).
#   - Streamable HTTP answers with SSE: `flush_interval -1` sends each event at
#     once; `read_timeout 5m` closes a leg whose upstream sent nothing for 5
#     minutes (the service pings open SSE streams every 15 s, so only a dead
#     upstream trips it); `encode` skips /mcp so events are never held in a
#     compression buffer.
#   - `Authorization` (the API key) is redacted from Caddy's access log by
#     default; never enable the `log_credentials` server option.
#   - One `mcp` replica (sessions live in the process); a second one needs
#     sticky routing on the `Mcp-Session-Id` header (Phase 2).

{$LKAP_PUBLIC_DOMAIN:localhost} {
	@compressible {
		not path /mcp /mcp/*
	}
	encode @compressible zstd gzip

	@mcp path /mcp /mcp/*
	handle @mcp {
		request_body {
			max_size 1MB
		}
		reverse_proxy mcp:8090 {
			flush_interval -1
			transport http {
				read_timeout 5m
			}
		}
	}

	@apiPaths path /v1/* /hooks/* /internal/*
	@internalRefused {
		path /internal/*
		not remote_ip {$LKAP_INTERNAL_ALLOWED_CIDRS:private_ranges}
	}
	handle @apiPaths {
		# `respond` runs before `reverse_proxy` in Caddy's fixed directive
		# order, so a refused /internal/* request never reaches the api.
		respond @internalRefused "forbidden: the internal worker API is not reachable from this address" 403
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
