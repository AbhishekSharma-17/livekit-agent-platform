    "ToolBinding": {
      "description": "Copy one part of a successful tool result onto the panel or into a variable (D-V6-23).\n\nApplied by the worker after a successful call (an HTTP 2xx, an app action that\nsucceeded, an MCP result that is not an error) and before the model's next turn, with\nno model involved. ``path`` points into the tool's result as the model would see it\n(after ``result_path``); ``\"\"`` is the whole result.",
      "properties": {
        "path": {
          "default": "",
          "maxLength": 256,
          "title": "Path",
          "type": "string"
        },
        "to": {
          "maxLength": 140,
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "title": "ToolBinding",
      "type": "object"
    },
    "ToolContextSpec": {
      "description": "The tool-context settings of one MCP tool (``McpServerDefinition.tool_context``).",
      "properties": {
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "confirm_readback": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Confirm Readback",
          "type": "array"
        },
        "pinned_arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "maxProperties": 20,
          "title": "Pinned Arguments",
          "type": "object"
        },
        "requires_vars": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires Vars",
          "type": "array"
        }
      },
      "title": "ToolContextSpec",
      "type": "object"
    },
    "ToolExecution": {
      "description": "How one tool runs relative to the conversation (BACKGROUND-TOOLS.md §2).\n\nThe agent-level default (``ToolsConfig.execution_default``) only ever reaches read\ntools: GET HTTP tools and the built-ins in :data:`BACKGROUNDABLE_BUILTINS`. The\ntools in :data:`NEVER_BACKGROUND_TOOLS` and the flow edge tools always block.",
      "properties": {
        "announce": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announce"
        },
        "auto_threshold_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 0,
          "title": "Auto Threshold Ms",
          "type": "integer"
        },
        "cancellable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancellable"
        },
        "duplicate_scope": {
          "default": "name_and_args",
          "enum": [
            "name",
            "name_and_args"
          ],
          "title": "Duplicate Scope",
          "type": "string"
        },
        "filler_delay_s": {
          "default": 4.0,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Filler Delay S",
          "type": "number"
        },
        "filler_interval_s": {
          "default": 8.0,
          "maximum": 60,
          "minimum": 1,
          "title": "Filler Interval S",
          "type": "number"
        },
        "fillers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Fillers",
          "type": "array"
        },
        "max_duration_s": {
