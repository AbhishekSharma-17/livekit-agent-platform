{
  "$id": "lkap-contracts/McpOAuthAuth.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sign in through the server's OAuth provider (V5-14; saved only once V5-14 lands).\n\nThe api is the OAuth client: it runs discovery, registration, consent and the token\nexchange, keeps the tokens in an ``mcp-oauth`` credential, and hands the worker a\nshort-lived access token at session start (research-v4 tools §4.3).",
  "properties": {
    "client_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Id"
    },
    "client_secret_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Secret Ref"
    },
    "credential_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Id"
    },
    "kind": {
      "const": "oauth",
      "default": "oauth",
      "title": "Kind",
      "type": "string"
    },
    "registration": {
      "default": "auto",
      "enum": [
        "auto",
        "preregistered"
      ],
      "title": "Registration",
      "type": "string"
    },
    "scopes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scopes"
    },
    "subject": {
      "default": "workspace",
      "enum": [
        "workspace",
        "agent"
      ],
      "title": "Subject",
      "type": "string"
    }
  },
  "title": "McpOAuthAuth",
  "type": "object"
}
