# Copy to deploy/api.env (human-created; read by deploy/docker-compose.yml
# `api.env_file`) and fill in real values. Never commit the copy.
# Field meanings: docs/CONTRACTS.md §3. Generate LKAP_MASTER_KEY with:
#   cd api && uv run python -m lkap_api.keys generate

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LKAP_AGENT_NAME=lkap-agent
LKAP_MASTER_KEY=
LKAP_ADMIN_TOKEN=
LKAP_SERVICE_TOKEN=
LKAP_CORS_ORIGINS=http://localhost:3000
LKAP_PACKS=packs.insurance_claim,packs.generic
LKAP_EMBEDDER=fastembed
LKAP_LOG_LEVEL=INFO
# optional dev-only credential seed: {"google-realtime": {"api_key": "..."}}
LKAP_BOOTSTRAP_CREDENTIALS_JSON=

# LKAP_DATA_DIR and PORT are set in docker-compose.yml `environment:` — do
# not override here unless you changed the volume/port mapping.
