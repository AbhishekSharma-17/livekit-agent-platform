{
  "$defs": {
    "ToolExecution": {
      "description": "How one tool runs relative to the conversation (BACKGROUND-TOOLS.md §2).\n\nThe agent-level default (``ToolsConfig.execution_default``) only ever reaches read\ntools: GET HTTP tools and the built-ins in :data:`BACKGROUNDABLE_BUILTINS`. The\ntools in :data:`NEVER_BACKGROUND_TOOLS` and the flow edge tools always block.",
      "properties": {
        "announce": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announce"
        },
        "auto_threshold_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 0,
          "title": "Auto Threshold Ms",
          "type": "integer"
        },
        "cancellable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancellable"
        },
        "duplicate_scope": {
          "default": "name_and_args",
          "enum": [
            "name",
            "name_and_args"
          ],
          "title": "Duplicate Scope",
          "type": "string"
        },
        "filler_delay_s": {
          "default": 4.0,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Filler Delay S",
          "type": "number"
        },
        "filler_interval_s": {
          "default": 8.0,
          "maximum": 60,
          "minimum": 1,
          "title": "Filler Interval S",
          "type": "number"
        },
        "fillers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Fillers",
          "type": "array"
        },
        "max_duration_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Max Duration S",
          "type": "number"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "blocking",
                "background",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "on_duplicate": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "reject",
                "replace",
                "confirm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Duplicate"
        },
        "report_progress": {
          "default": false,
          "title": "Report Progress",
          "type": "boolean"
        }
      },
      "title": "ToolExecution",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ProviderToolDefinition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One action of a connected app run through a tool provider (docs/v5/COMPOSIO.md §3, D-V5-C8).\n\nCreated by materialisation (``POST /v1/tool-providers/composio/materialise``): the\nparameters are pinned from the provider's schema at import, the description is its first\nsentence (editable). The worker runs it with ``POST /api/v3.1/tools/execute/{tool_slug}``\non the provider's host. ``headers`` carry the provider key as a ``{{ secret.NAME }}``\nplaceholder that the api substitutes from ``credential_id`` when a session resolves, as\nfor HTTP tools; ``connection_id`` is the connected-app row, ``subject`` the provider's\n``user_id`` copied from it.",
  "properties": {
    "connected_account_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connected Account Id"
    },
    "connection_id": {
      "title": "Connection Id",
      "type": "string"
    },
    "credential_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Id"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/ToolExecution"
    },
    "headers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Headers",
      "type": "object"
    },
    "kind": {
      "const": "provider",
      "default": "provider",
      "title": "Kind",
      "type": "string"
    },
    "max_result_chars": {
      "default": 1500,
      "maximum": 20000,
      "minimum": 100,
      "title": "Max Result Chars",
      "type": "integer"
    },
    "name": {
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
      "title": "Name",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "provider": {
      "const": "composio",
      "default": "composio",
      "title": "Provider",
      "type": "string"
    },
    "result_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "data",
      "title": "Result Path"
    },
    "risk": {
      "default": "write",
      "enum": [
        "read",
        "write",
        "destructive"
      ],
      "title": "Risk",
      "type": "string"
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Version"
    },
    "silent_reply": {
      "default": false,
      "title": "Silent Reply",
      "type": "boolean"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "timeout_s": {
      "default": 10,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Timeout S",
      "type": "number"
    },
    "tool_slug": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Tool Slug",
      "type": "string"
    },
    "toolkit": {
      "default": "",
      "title": "Toolkit",
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "parameters",
    "tool_slug",
    "connection_id",
    "subject"
  ],
  "title": "ProviderToolDefinition",
  "type": "object"
}
