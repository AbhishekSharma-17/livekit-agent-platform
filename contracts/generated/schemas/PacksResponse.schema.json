{
  "$defs": {
    "AvatarOptions": {
      "description": "Publisher-side options applied to whichever avatar plugin is selected.",
      "properties": {
        "idle_timeout_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Timeout S"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "participant_name": {
          "default": "Avatar",
          "title": "Participant Name",
          "type": "string"
        },
        "video_quality": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "very_high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Quality"
        }
      },
      "title": "AvatarOptions",
      "type": "object"
    },
    "BlockSpec": {
      "description": "One block of a composite panel (CONTRACTS-V2 §4.4).\n\n``id`` keys the block's state in :attr:`UiState.blocks`; ``config`` is\nblock-type specific and rendered by the matching React component.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "default": {},
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "enum": [
            "status",
            "notes",
            "checklist",
            "activity",
            "form",
            "document",
            "gallery",
            "table",
            "transcript",
            "video",
            "kb_citations",
            "custom",
            "choices",
            "details",
            "markdown",
            "steps",
            "consent"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "BlockSpec",
      "type": "object"
    },
    "CapabilitiesConfig": {
      "description": "Which input affordances the session page offers.",
      "properties": {
        "camera": {
          "default": false,
          "title": "Camera",
          "type": "boolean"
        },
        "chat_input": {
          "default": true,
          "title": "Chat Input",
          "type": "boolean"
        },
        "dtmf": {
          "default": false,
          "title": "Dtmf",
          "type": "boolean"
        },
        "screen_share": {
          "default": false,
          "title": "Screen Share",
          "type": "boolean"
        },
        "vision_inject_per_turn": {
          "default": true,
          "title": "Vision Inject Per Turn",
          "type": "boolean"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    },
    "EndpointingOptions": {
      "additionalProperties": true,
      "description": "When the caller's turn counts as finished (SDK ``EndpointingOptions``, ``turn.py:113``).",
      "properties": {
        "alpha": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "max_delay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Delay"
        },
        "min_delay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Delay"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "fixed",
                "dynamic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "title": "EndpointingOptions",
      "type": "object"
    },
    "InterruptionOptions": {
      "additionalProperties": true,
      "description": "How the caller interrupts the agent (SDK ``InterruptionOptions``, ``turn.py:150``).",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "false_interruption_timeout": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Interruption Timeout"
        },
        "min_duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Duration"
        },
        "min_words": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Words"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "adaptive",
                "vad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "resume_false_interruption": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume False Interruption"
        }
      },
      "title": "InterruptionOptions",
      "type": "object"
    },
    "KbSeed": {
      "description": "A knowledge base the api creates when seeding an agent from this pack.",
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "kb_name": {
          "title": "Kb Name",
          "type": "string"
        }
      },
      "required": [
        "kb_name",
        "files"
      ],
      "title": "KbSeed",
      "type": "object"
    },
    "PackManifest": {
      "description": "Everything the api and console need to know about a pack.",
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockSpec"
          },
          "title": "Blocks",
          "type": "array"
        },
        "builtin_tools_disabled": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Builtin Tools Disabled",
          "type": "array"
        },
        "capabilities": {
          "$ref": "#/$defs/CapabilitiesConfig"
        },
        "default_greeting": {
          "title": "Default Greeting",
          "type": "string"
        },
        "default_instructions": {
          "title": "Default Instructions",
          "type": "string"
        },
        "default_panel": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_voice": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Default Voice",
          "type": "object"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "instructions_by_mode": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "realtime",
              "cascaded",
              "half_cascade"
            ]
          },
          "title": "Instructions By Mode",
          "type": "object"
        },
        "kb_seeds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KbSeed"
          },
          "title": "Kb Seeds",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "recommended_pipeline": {
          "$ref": "#/$defs/PipelineConfig"
        },
        "settings_schema": {
          "additionalProperties": true,
          "default": {
            "type": "object"
          },
          "title": "Settings Schema",
          "type": "object"
        },
        "state_schema": {
          "additionalProperties": true,
          "title": "State Schema",
          "type": "object"
        },
        "tool_names": {
          "items": {
            "type": "string"
          },
          "title": "Tool Names",
          "type": "array"
        },
        "ui_panel_id": {
          "title": "Ui Panel Id",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "description",
        "ui_panel_id",
        "default_instructions",
        "default_greeting",
        "recommended_pipeline",
        "capabilities",
        "tool_names",
        "state_schema"
      ],
      "title": "PackManifest",
      "type": "object"
    },
    "PackOut": {
      "description": "One discovered pack.",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/PackManifest"
        }
      },
      "required": [
        "manifest"
      ],
      "title": "PackOut",
      "type": "object"
    },
    "PanelLayout": {
      "description": "Which panel renders the session, and (for ``composite``) its blocks.",
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockSpec"
          },
          "title": "Blocks",
          "type": "array"
        },
        "layout": {
          "default": "side",
          "enum": [
            "side",
            "wide"
          ],
          "title": "Layout",
          "type": "string"
        },
        "panel_id": {
          "default": "composite",
          "title": "Panel Id",
          "type": "string"
        }
      },
      "title": "PanelLayout",
      "type": "object"
    },
    "PipelineConfig": {
      "description": "Which providers fill which slot, and how turns are handled.\n\nSlot requirements per mode are reported by :func:`pipeline_issues` rather\nthan raised here: the api returns them as a ``ValidationResult`` so a\nhalf-finished pipeline can still be saved as a draft.",
      "properties": {
        "avatar": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avatar_options": {
          "$ref": "#/$defs/AvatarOptions",
          "default": {
            "idle_timeout_s": null,
            "max_duration_s": null,
            "participant_name": "Avatar",
            "video_quality": null
          }
        },
        "conversation_preset": {
          "default": "custom",
          "enum": [
            "patient",
            "balanced",
            "snappy",
            "telephony",
            "custom"
          ],
          "title": "Conversation Preset",
          "type": "string"
        },
        "image_gen": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "cascaded",
          "enum": [
            "realtime",
            "cascaded",
            "half_cascade"
          ],
          "title": "Mode",
          "type": "string"
        },
        "noise_cancellation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "realtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_detection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_detector": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnDetectorSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_handling": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnHandlingOptions"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": {},
          "title": "Turn Handling"
        },
        "vad": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflow_llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "PreemptiveGenerationOptions": {
      "additionalProperties": true,
      "description": "Start the reply before the caller's turn is confirmed (SDK ``turn.py:201``).",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "max_retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Retries"
        },
        "max_speech_duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Speech Duration"
        },
        "preemptive_tts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preemptive Tts"
        }
      },
      "title": "PreemptiveGenerationOptions",
      "type": "object"
    },
    "ProviderRef": {
      "description": "Points at a registry provider plus the credential and options to use.",
      "properties": {
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Fields",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "ProviderRef",
      "type": "object"
    },
    "TurnDetectorSettings": {
      "description": "``PipelineConfig.turn_detector``: the end-of-turn model's placement and sensitivity.\n\nApplies to the LiveKit turn detector (``inference.TurnDetector``, 1.8.3\n``inference/eot/detector.py:35-47``) and to the local plugin model, on top of the\nconnection's ``turn_detector_mode``: a connection without hosted Inference always\nruns the local model, whatever ``mode`` says.",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "enum": [
                "hosted",
                "local"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "unlikely_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlikely Threshold"
        }
      },
      "title": "TurnDetectorSettings",
      "type": "object"
    },
    "TurnHandlingOptions": {
      "additionalProperties": true,
      "description": "``AgentSession(turn_handling=...)`` as the console edits it (SDK ``turn.py:260``).",
      "properties": {
        "endpointing": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointingOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interruption": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterruptionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preemptive_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreemptiveGenerationOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_detection": {
          "anyOf": [
            {
              "enum": [
                "stt",
                "vad",
                "realtime_llm",
                "manual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Detection"
        },
        "user_turn_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserTurnLimitOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TurnHandlingOptions",
      "type": "object"
    },
    "UserTurnLimitOptions": {
      "additionalProperties": true,
      "description": "Stop a caller who talks too long without a reply (SDK ``turn.py:231``; off by default).",
      "properties": {
        "max_duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration"
        },
        "max_words": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Words"
        }
      },
      "title": "UserTurnLimitOptions",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/PacksResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /v1/packs``.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/PackOut"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "PacksResponse",
  "type": "object"
}
