{
  "$id": "lkap-contracts/HealthResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /v1/health``.\n\n``db`` is ``ok`` only when the database answers *and* its Alembic revision\nequals the migration head, so an un-migrated or half-migrated schema reports\n``error``. ``agents_unbound`` counts agents with no LiveKit connection\n(CONTRACTS-V2 §1.3); it should be 0 once bootstrap has run.",
  "properties": {
    "agents_unbound": {
      "default": 0,
      "title": "Agents Unbound",
      "type": "integer"
    },
    "db": {
      "enum": [
        "ok",
        "error"
      ],
      "title": "Db",
      "type": "string"
    },
    "livekit_url": {
      "title": "Livekit Url",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "packs": {
      "items": {
        "type": "string"
      },
      "title": "Packs",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "version",
    "livekit_url",
    "packs",
    "db"
  ],
  "title": "HealthResponse",
  "type": "object"
}
