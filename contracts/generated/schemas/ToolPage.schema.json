{
  "$defs": {
    "HttpToolDefinition": {
      "description": "An HTTP call exposed to the model as a raw-schema function tool.",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "body_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Template"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "http",
          "default": "http",
          "title": "Kind",
          "type": "string"
        },
        "max_result_chars": {
          "default": 4000,
          "title": "Max Result Chars",
          "type": "integer"
        },
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Path"
        },
        "silent_reply": {
          "default": false,
          "title": "Silent Reply",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 10,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "parameters",
        "url"
      ],
      "title": "HttpToolDefinition",
      "type": "object"
    },
    "McpServerDefinition": {
      "description": "A streamable-HTTP MCP server attached to the agent.",
      "properties": {
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "mcp",
          "default": "mcp",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sse_read_timeout_s": {
          "default": 300,
          "title": "Sse Read Timeout S",
          "type": "number"
        },
        "timeout_s": {
          "default": 5,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "McpServerDefinition",
      "type": "object"
    },
    "ToolOut": {
      "description": "A stored tool row.",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "definition": {
          "discriminator": {
            "mapping": {
              "http": "#/$defs/HttpToolDefinition",
              "mcp": "#/$defs/McpServerDefinition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HttpToolDefinition"
            },
            {
              "$ref": "#/$defs/McpServerDefinition"
            }
          ],
          "title": "Definition"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "http",
            "mcp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "definition",
        "id",
        "created_at",
        "updated_at"
      ],
      "title": "ToolOut",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ToolPage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ToolOut"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "ToolPage",
  "type": "object"
}
