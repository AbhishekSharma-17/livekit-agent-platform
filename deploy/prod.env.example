# Copy to deploy/prod.env (human-created; never commit the copy) and pass it
# to compose explicitly — unlike api.env/web.env/supervisor.env (loaded by
# each service's own `env_file:`, i.e. injected into that CONTAINER's
# runtime environment), this file is read by the `docker compose` COMMAND
# ITSELF for `${VAR}` substitution inside docker-compose.prod.yml — a
# different mechanism, so this file's values are NOT automatically visible
# inside any container unless the compose file also references them via
# `${...}` in that service's `environment:` (which it does, for every
# variable below):
#
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/prod.env up -d --build
#
# Single source of truth: each value here is referenced by `${...}` from one
# or more services in docker-compose.prod.yml — never duplicate it into
# api.env/web.env/supervisor.env as well.

# The domain Caddy requests a TLS certificate for and the api/web publish
# links against (LKAP_PUBLIC_BASE_URL / LKAP_WEB_BASE_URL / LKAP_CORS_ORIGINS
# are all derived from this in docker-compose.prod.yml). Use a real domain
# with DNS pointed at this host for Caddy's automatic HTTPS to succeed; for a
# bare smoke test without DNS, set this to your host's IP or "localhost" —
# Caddy then serves a self-signed/internal cert instead of a real one.
LKAP_PUBLIC_DOMAIN=

# Postgres password — also becomes part of LKAP_DATABASE_URL (built inside
# docker-compose.prod.yml, not here).
LKAP_POSTGRES_PASSWORD=

# MinIO / S3 credentials, shared by the `minio` server, `minio-init` (creates
# the bucket), and the `api`/`jobs` services (as LKAP_STORAGE_ACCESS_KEY/
# LKAP_STORAGE_SECRET_KEY). Use URL-safe characters (letters, digits, - _ . ~):
# `minio-init` passes them inside its MC_HOST_local URL.
LKAP_STORAGE_ACCESS_KEY=
LKAP_STORAGE_SECRET_KEY=
LKAP_STORAGE_BUCKET=lkap

# The GID that owns /var/run/docker.sock on THIS host, so the non-root
# `supervisor` container's `docker` backend can use the mounted socket:
#   stat -c '%g' /var/run/docker.sock   # Linux
#   stat -f '%g' /var/run/docker.sock   # macOS
LKAP_DOCKER_GID=999

# Optional: tag suffix for the images this compose file builds/references
# (lkap-api:$LKAP_IMAGE_TAG, lkap-web:$LKAP_IMAGE_TAG, lkap-agent:slim-$LKAP_IMAGE_TAG, ...).
# Defaults to "prod" if unset.
LKAP_IMAGE_TAG=prod

# Who may reach the api's internal worker API (/internal/*) through Caddy
# (V2-22, ruling R-V2-27). Space-separated CIDRs or single IPs; the default,
# `private_ranges`, admits the compose network and private LANs only. Workers
# that call back over the internet (LiveKit Cloud-hosted agents, a worker on
# another network) need their egress addresses listed here, for example
#   LKAP_INTERNAL_ALLOWED_CIDRS=private_ranges 203.0.113.7/32
# Leave unset for the default; an empty value also means the default.
LKAP_INTERNAL_ALLOWED_CIDRS=
