{
  "$defs": {
    "CatalogItem": {
      "description": "One model, voice, avatar or persona listed by a vendor catalog adapter.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "meta": {
          "additionalProperties": true,
          "default": {},
          "title": "Meta",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "CatalogItem",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/CredentialTestResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``POST /v1/credentials/{id}/test``.",
  "properties": {
    "catalog_preview": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CatalogItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Preview"
    },
    "checked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked At"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "message"
  ],
  "title": "CredentialTestResult",
  "type": "object"
}
