LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LKAP_AGENT_NAME=lkap-agent
LKAP_MASTER_KEY=            # uv run python -m lkap_api.keys generate
LKAP_ADMIN_TOKEN=dev-admin
LKAP_SERVICE_TOKEN=dev-service
LKAP_DATA_DIR=./data
LKAP_DATABASE_URL=          # default sqlite+aiosqlite:///./data/lkap.db
LKAP_CORS_ORIGINS=http://localhost:3000
LKAP_PACKS=packs.insurance_claim,packs.generic
LKAP_EMBEDDER=fastembed
LKAP_LOG_LEVEL=INFO
LKAP_LOG_JSON=false
# optional dev seed: {"google-realtime": {"api_key": "..."}}
LKAP_BOOTSTRAP_CREDENTIALS_JSON=
# stale-session sweep (defaults shown; D-W2-2b)
LKAP_SESSION_SWEEP_INTERVAL_S=60
LKAP_SESSION_STALE_CREATED_S=600
LKAP_SESSION_STALE_ACTIVE_S=21600
