{
  "$id": "lkap-contracts/TransferNode.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Hands the call to a human or another number.",
  "properties": {
    "announce": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Announce"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "transfer",
      "default": "transfer",
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "default": "",
      "title": "Label",
      "type": "string"
    },
    "mode": {
      "default": "cold",
      "enum": [
        "cold",
        "warm"
      ],
      "title": "Mode",
      "type": "string"
    },
    "position": {
      "default": [
        0.0,
        0.0
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Position",
      "type": "array"
    },
    "to": {
      "title": "To",
      "type": "string"
    }
  },
  "required": [
    "id",
    "to"
  ],
  "title": "TransferNode",
  "type": "object"
}
