{
  "$defs": {
    "SmsTarget": {
      "description": "One number ``send_sms`` may text, named by its label (V5-25).",
      "properties": {
        "label": {
          "description": "What the model and the caller call it",
          "maxLength": 64,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "to": {
          "description": "E.164 mobile number",
          "maxLength": 16,
          "pattern": "^\\+[1-9]\\d{6,14}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "label",
        "to"
      ],
      "title": "SmsTarget",
      "type": "object"
    },
    "TransferTarget": {
      "description": "One destination the agent may transfer a caller to.",
      "properties": {
        "label": {
          "description": "What the model and the caller call it",
          "maxLength": 64,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "to": {
          "description": "E.164 number or tel:/sip:/sips: URI",
          "maxLength": 256,
          "pattern": "^(\\+[1-9]\\d{6,14}|tel:\\+?[0-9]{3,20}|sips?:[^\\s@]+@[^\\s]+)$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "label",
        "to"
      ],
      "title": "TransferTarget",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/TelephonyConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Phone-call settings of an agent (``AgentConfig.telephony``).",
  "properties": {
    "sms_targets": {
      "description": "Numbers the agent may text by label, besides the caller of a phone call (send_sms).",
      "items": {
        "$ref": "#/$defs/SmsTarget"
      },
      "maxItems": 50,
      "title": "Sms Targets",
      "type": "array"
    },
    "transfer_targets": {
      "items": {
        "$ref": "#/$defs/TransferTarget"
      },
      "maxItems": 50,
      "title": "Transfer Targets",
      "type": "array"
    }
  },
  "title": "TelephonyConfig",
  "type": "object"
}
