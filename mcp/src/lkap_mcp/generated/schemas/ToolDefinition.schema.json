{
  "$defs": {
    "DatasetToolDefinition": {
      "description": "A lookup in one of the workspace's datasets (V6-16, D-V6-27; ``lkap_contracts.datasets``).\n\nThe model sees one string argument per key column (``key_columns``, minus the pinned\nones) and gets back at most ``max_rows`` rows with ``return_columns`` (all columns when\nempty), matched ``exact`` or by ``prefix`` on the normalised value. The worker calls the\napi's internal lookup route with the session, so a lookup never reads another\nworkspace's dataset, and fences the rows as ``dataset:<name>``. Read-only: nothing is\never written to a dataset from a call. The tool always runs blocking (a lookup is quick).\n\nV6-07: ``pinned_arguments`` fix a key column's value, hidden from the model (a string may\nbe ``{{ ctx.caller_phone }}`` or ``{{ var.policy_number }}``); ``requires_vars`` refuse\nuntil variables are set; ``bindings`` copy a successful lookup onto the panel. The bound\n(and model-visible) result is the list of rows, so ``/0/holder_name`` is the first row's\n``holder_name``.",
      "properties": {
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "dataset_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "key_columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Key Columns",
          "type": "array"
        },
        "kind": {
          "const": "dataset",
          "default": "dataset",
          "title": "Kind",
          "type": "string"
        },
        "match": {
          "default": "exact",
          "enum": [
            "exact",
            "prefix"
          ],
          "title": "Match",
          "type": "string"
        },
        "max_result_chars": {
          "default": 2000,
          "maximum": 8000,
          "minimum": 100,
          "title": "Max Result Chars",
          "type": "integer"
        },
        "max_rows": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "pinned_arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "maxProperties": 20,
          "title": "Pinned Arguments",
          "type": "object"
        },
        "requires_vars": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires Vars",
          "type": "array"
        },
        "return_columns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Return Columns",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "dataset_id",
        "key_columns"
      ],
      "title": "DatasetToolDefinition",
      "type": "object"
    },
    "HttpToolDefinition": {
      "description": "An HTTP call exposed to the model as a raw-schema function tool.",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "body_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Template"
        },
        "confirm_readback": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Confirm Readback",
          "type": "array"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/ToolExecution"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "http",
          "default": "http",
          "title": "Kind",
          "type": "string"
        },
        "max_result_chars": {
          "default": 4000,
          "title": "Max Result Chars",
          "type": "integer"
        },
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "requires_vars": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires Vars",
          "type": "array"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Path"
        },
        "silent_reply": {
          "default": false,
          "title": "Silent Reply",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 10,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "parameters",
        "url"
      ],
      "title": "HttpToolDefinition",
      "type": "object"
    },
    "McpHeaderAuth": {
      "description": "Static request headers, typically an API key (research-v4 tools §4.3.1).\n\nHeader values may reference ``{{ secret.NAME }}``; the api substitutes them from\n``credential_id`` (an ``http-tool-secret`` bag) when a session resolves.",
      "properties": {
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "header",
          "default": "header",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "McpHeaderAuth",
      "type": "object"
    },
    "McpNoAuth": {
      "description": "The MCP server needs no credentials (a public server).",
      "properties": {
        "kind": {
          "const": "none",
          "default": "none",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "McpNoAuth",
      "type": "object"
    },
    "McpOAuthAuth": {
      "description": "Sign in through the server's OAuth provider (V5-14; saved only once V5-14 lands).\n\nThe api is the OAuth client: it runs discovery, registration, consent and the token\nexchange, keeps the tokens in an ``mcp-oauth`` credential, and hands the worker a\nshort-lived access token at session start (research-v4 tools §4.3).",
      "properties": {
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "client_secret_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret Ref"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "kind": {
          "const": "oauth",
          "default": "oauth",
          "title": "Kind",
          "type": "string"
        },
        "registration": {
          "default": "auto",
          "enum": [
            "auto",
            "preregistered"
          ],
          "title": "Registration",
          "type": "string"
        },
        "scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scopes"
        },
        "subject": {
          "default": "workspace",
          "enum": [
            "workspace",
            "agent"
          ],
          "title": "Subject",
          "type": "string"
        }
      },
      "title": "McpOAuthAuth",
      "type": "object"
    },
    "McpServerDefinition": {
      "description": "A streamable-HTTP MCP server attached to the agent.\n\n``auth`` says how the worker authenticates. ``headers`` and ``credential_id`` are the\npre-V5-09 shape, kept as **deprecated mirrors** of header auth so readers that have not\nmoved to ``auth`` yet keep working: a definition that sets them without ``auth`` (or\nwith ``auth.kind == \"none\"``) folds them into :class:`McpHeaderAuth`; with ``auth`` set\nthey are filled from it (``credential_id`` also mirrors an OAuth credential), and a\nvalue that disagrees with ``auth`` is an error. Stored rows need no data migration:\nthey load as header auth and re-save with ``auth``.",
      "properties": {
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "auth": {
          "discriminator": {
            "mapping": {
              "header": "#/$defs/McpHeaderAuth",
              "none": "#/$defs/McpNoAuth",
              "oauth": "#/$defs/McpOAuthAuth"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/McpNoAuth"
            },
            {
              "$ref": "#/$defs/McpHeaderAuth"
            },
            {
              "$ref": "#/$defs/McpOAuthAuth"
            }
          ],
          "title": "Auth"
        },
        "cached_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached At"
        },
        "cached_tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/McpToolSnapshot"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Tools"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "mcp",
          "default": "mcp",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpServerOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sse_read_timeout_s": {
          "default": 300,
          "title": "Sse Read Timeout S",
          "type": "number"
        },
        "timeout_s": {
          "default": 5,
          "title": "Timeout S",
          "type": "number"
        },
        "tool_context": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolContextSpec"
          },
          "default": {},
          "title": "Tool Context",
          "type": "object"
        },
        "tool_options": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolExecution"
          },
          "default": {},
          "title": "Tool Options",
          "type": "object"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "McpServerDefinition",
      "type": "object"
    },
    "McpServerOrigin": {
      "description": "Where a provider-provisioned MCP server comes from (docs/v5/COMPOSIO.md §3).",
      "properties": {
        "config_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        },
        "kind": {
          "enum": [
            "server",
            "router"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "const": "composio",
          "default": "composio",
          "title": "Provider",
          "type": "string"
        },
        "remote_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Remote Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "remote_id"
      ],
      "title": "McpServerOrigin",
      "type": "object"
    },
    "McpToolSnapshot": {
      "description": "One tool of a server's ``tools/list`` answer, as ``POST /v1/tools/{id}/test`` stored it.",
      "properties": {
        "description": {
          "anyOf": [
