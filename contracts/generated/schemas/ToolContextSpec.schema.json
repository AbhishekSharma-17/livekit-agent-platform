{
  "$defs": {
    "ToolBinding": {
      "description": "Copy one part of a successful tool result onto the panel or into a variable (D-V6-23).\n\nApplied by the worker after a successful call (an HTTP 2xx, an app action that\nsucceeded, an MCP result that is not an error) and before the model's next turn, with\nno model involved. ``path`` points into the tool's result as the model would see it\n(after ``result_path``); ``\"\"`` is the whole result.",
      "properties": {
        "path": {
          "default": "",
          "maxLength": 256,
          "title": "Path",
          "type": "string"
        },
        "to": {
          "maxLength": 140,
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "title": "ToolBinding",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ToolContextSpec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The tool-context settings of one MCP tool (``McpServerDefinition.tool_context``).",
  "properties": {
    "bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolBinding"
      },
      "title": "Bindings",
      "type": "array"
    },
    "confirm_readback": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Confirm Readback",
      "type": "array"
    },
    "pinned_arguments": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "default": {},
      "maxProperties": 20,
      "title": "Pinned Arguments",
      "type": "object"
    },
    "requires_vars": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Requires Vars",
      "type": "array"
    }
  },
  "title": "ToolContextSpec",
  "type": "object"
}
