{
  "$defs": {
    "KbDocumentOut": {
      "description": "An uploaded document and its ingestion status.",
      "properties": {
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "chunk_count": {
          "title": "Chunk Count",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kb_id": {
          "title": "Kb Id",
          "type": "string"
        },
        "mime": {
          "title": "Mime",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kb_id",
        "filename",
        "mime",
        "bytes",
        "status",
        "chunk_count",
        "created_at"
