{
  "$defs": {
    "HttpToolDefinition": {
      "description": "An HTTP call exposed to the model as a raw-schema function tool.",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "body_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Template"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/ToolExecution"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Headers",
          "type": "object"
        },
        "kind": {
          "const": "http",
          "default": "http",
          "title": "Kind",
          "type": "string"
        },
        "max_result_chars": {
          "default": 4000,
          "title": "Max Result Chars",
          "type": "integer"
        },
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Path"
        },
        "silent_reply": {
          "default": false,
          "title": "Silent Reply",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 10,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "parameters",
        "url"
      ],
      "title": "HttpToolDefinition",
      "type": "object"
    },
    "ToolExecution": {
      "description": "How one tool runs relative to the conversation (BACKGROUND-TOOLS.md §2).\n\nThe agent-level default (``ToolsConfig.execution_default``) only ever reaches read\ntools: GET HTTP tools and the built-ins in :data:`BACKGROUNDABLE_BUILTINS`. The\ntools in :data:`NEVER_BACKGROUND_TOOLS` and the flow edge tools always block.",
      "properties": {
        "announce": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announce"
        },
        "auto_threshold_ms": {
          "default": 700,
          "maximum": 5000,
          "minimum": 0,
          "title": "Auto Threshold Ms",
          "type": "integer"
        },
        "cancellable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancellable"
        },
        "duplicate_scope": {
          "default": "name_and_args",
          "enum": [
            "name",
            "name_and_args"
          ],
          "title": "Duplicate Scope",
          "type": "string"
        },
        "filler_delay_s": {
          "default": 4.0,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Filler Delay S",
          "type": "number"
        },
        "filler_interval_s": {
          "default": 8.0,
          "maximum": 60,
          "minimum": 1,
          "title": "Filler Interval S",
          "type": "number"
        },
        "fillers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Fillers",
          "type": "array"
        },
        "max_duration_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Max Duration S",
          "type": "number"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "blocking",
                "background",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "on_duplicate": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "reject",
                "replace",
                "confirm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Duplicate"
        },
        "report_progress": {
          "default": false,
          "title": "Report Progress",
          "type": "boolean"
        }
      },
      "title": "ToolExecution",
      "type": "object"
    },
    "ToolTemplateDefault": {
      "description": "An argument of a template the admin may fix when adding the tool (``event_type_id``).",
      "properties": {
        "help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "description": "The argument name in the tool's parameters",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "ToolTemplateDefault",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/ToolTemplate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A ready-made HTTP tool (D-V5-36): the definition plus what an admin supplies to add it.\n\n``definition`` references its key as ``{{ secret.NAME }}`` (``secret_names``) and is stored\nas a normal HTTP tool when instantiated; ``defaults`` become the JSON Schema ``default`` of\nthose arguments (an argument the model leaves out takes it).",
  "properties": {
    "defaults": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolTemplateDefault"
      },
      "title": "Defaults",
      "type": "array"
    },
    "definition": {
      "$ref": "#/$defs/HttpToolDefinition"
    },
    "docs_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Docs Url"
    },
    "group": {
      "description": "The set the template belongs to (`cal_com`)",
      "title": "Group",
      "type": "string"
    },
    "group_label": {
      "title": "Group Label",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,40}\\.[a-z][a-z0-9_]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "risk": {
      "default": "read",
      "enum": [
        "read",
        "write"
      ],
      "title": "Risk",
      "type": "string"
    },
    "secret_names": {
      "description": "The `http-tool-secret` names the key must hold",
      "items": {
        "type": "string"
      },
      "title": "Secret Names",
      "type": "array"
    },
    "summary": {
      "description": "One plain-language line for the console",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "id",
    "group",
    "group_label",
    "label",
    "summary",
    "secret_names",
    "definition"
  ],
  "title": "ToolTemplate",
  "type": "object"
}
