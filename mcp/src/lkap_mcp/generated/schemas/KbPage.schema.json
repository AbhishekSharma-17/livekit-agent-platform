{
  "$defs": {
    "KbOut": {
      "description": "A knowledge base with its current counts.",
      "properties": {
        "chunk_count": {
          "title": "Chunk Count",
          "type": "integer"
        },
        "chunking": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`{max_tokens, overlap}` of the chunker; null means the defaults.",
          "title": "Chunking"
        },
        "connection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The knowledge connection holding the vectors; null = the platform's store.",
          "title": "Connection Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vector width recorded at creation; null for a KB created before V5-01.",
          "title": "Dimension"
        },
        "document_count": {
          "title": "Document Count",
          "type": "integer"
        },
        "embedder_id": {
          "title": "Embedder Id",
          "type": "string"
        },
        "embedder_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Embedding model recorded at creation; null for a KB created before V5-01.",
          "title": "Embedder Model"
        },
        "external_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the vectors live in the connection (collection, index and namespace, or tenant).",
          "title": "External Ref"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "managed",
          "description": "`managed`: the platform ingests it.",
          "enum": [
            "managed",
            "external"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "embedder_id",
        "chunk_count",
        "document_count",
        "created_at",
        "updated_at"
      ],
      "title": "KbOut",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/KbPage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/KbOut"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "KbPage",
  "type": "object"
}
