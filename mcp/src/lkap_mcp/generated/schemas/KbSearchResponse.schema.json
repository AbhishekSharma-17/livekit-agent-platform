{
  "$defs": {
    "KbHit": {
      "description": "One retrieved chunk, its locators and the score of every stage that ran for it.\n\n``score`` is on [0, 1] in every mode: cosine similarity (``vector``), the\nreciprocal-rank fusion normalised to its maximum (``fused``) or the\ncross-encoder logit through a sigmoid (``rerank``); ``score_source`` says which.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "fused_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reciprocal-rank fusion, normalised to (0, 1]; hybrid mode only.",
          "title": "Fused Score"
        },
        "kb_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The knowledge base the chunk belongs to; null from a pre-V5-04 api.",
          "title": "Kb Id"
        },
        "lexical_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based rank in the keyword list; null when not in it (or not hybrid).",
          "title": "Lexical Rank"
        },
        "meta": {
          "additionalProperties": true,
          "description": "The chunk's locators: `filename`, and for chunks ingested since V5-01 `heading_path`, `page`, `char_start`, `char_end`. A managed-search hit (V5-45) carries `document_name`, `source` (`ragie`), `chunk_index` and, when the service knows it, `url`.",
          "title": "Meta",
          "type": "object"
        },
        "rerank_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cross-encoder relevance through a sigmoid, (0, 1); reranked hits only.",
          "title": "Rerank Score"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_source": {
          "default": "vector",
          "description": "Which stage `score` is: `vector`, `fused` or `rerank`; `external` is a managed search service's own relevance, relative to that one search and not comparable with the others.",
          "enum": [
            "vector",
            "fused",
            "rerank",
            "external"
          ],
          "title": "Score Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "vector_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cosine similarity to the query; null when not in the vector list.",
          "title": "Vector Score"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "filename",
        "score",
        "text"
      ],
      "title": "KbHit",
      "type": "object"
    },
    "KbRerankUsage": {
      "description": "One hosted re-rank call and its cost line (D-V5-19; an unknown price is never zero).",
      "properties": {
        "connection_id": {
          "title": "Connection Id",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the price table has no row.",
          "title": "Cost Usd"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`no price` when the price is unknown.",
          "title": "Note"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "quantity": {
          "description": "Searches (Cohere) or tokens (Voyage) the vendor billed.",
          "title": "Quantity",
          "type": "number"
        },
        "unit": {
          "enum": [
            "tokens_in",
            "tokens_out",
            "audio_s_in",
            "audio_s_out",
            "chars",
            "minutes",
            "images",
            "text_tokens_in",
            "text_tokens_out",
            "audio_tokens_in",
            "audio_tokens_out",
            "cached_tokens_in",
            "requests"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "provider_id",
        "model",
        "unit",
        "quantity"
      ],
      "title": "KbRerankUsage",
      "type": "object"
    },
    "KbSearchWarning": {
      "description": "Something the search skipped or degraded, without failing.",
      "properties": {
        "code": {
          "enum": [
            "kb_not_found",
            "kb_embedder_mismatch",
            "kb_timeout",
            "kb_error",
            "lexical_unavailable",
            "rerank_failed",
            "rerank_refused"
          ],
          "title": "Code",
          "type": "string"
        },
        "kb_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "KbSearchWarning",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/KbSearchResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Search results, best first, with what was dropped or skipped on the way.",
  "properties": {
    "dropped": {
      "default": 0,
      "description": "Hits of the top `k` removed by `min_score`.",
      "title": "Dropped",
      "type": "integer"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/KbHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "min_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Score"
    },
    "mode": {
      "default": "vector",
      "enum": [
        "vector",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "rerank": {
      "default": "none",
      "maxLength": 75,
      "pattern": "^(none|local|connection:[A-Za-z0-9_-]{1,64})$",
      "title": "Rerank",
      "type": "string"
    },
    "rerank_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/KbRerankUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The hosted re-ranking call this search made, with its cost line."
    },
    "timings_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "`embed`, `retrieve`, `rerank` and `total`, in milliseconds.",
      "title": "Timings Ms",
      "type": "object"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/KbSearchWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "hits"
  ],
  "title": "KbSearchResponse",
  "type": "object"
}
