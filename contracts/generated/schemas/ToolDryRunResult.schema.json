  "properties": {
    "duration_ms": {
      "title": "Duration Ms",
      "type": "integer"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "result": {
      "title": "Result",
      "type": "string"
    },
    "status_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    }
  },
  "required": [
    "ok",
    "result",
    "duration_ms"
  ],
  "title": "ToolDryRunResult",
  "type": "object"
}
