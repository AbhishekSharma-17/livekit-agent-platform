{
  "$defs": {
    "KbCitation": {
      "description": "One retrieved chunk cited to the user.\n\nThe locators (V5-08) come from the chunk's ingest metadata (V5-01) and are\nabsent for chunks ingested before it. Tapping a citation sends\n``block_action {name: \"open_citation\", data: {chunk_id}}``; the worker\nopens the source page in a ``document`` block when it has the source.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "heading_path": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Path"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "filename",
        "score",
        "text"
      ],
      "title": "KbCitation",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/KbCitationsBlockState.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Knowledge-base hits backing the agent's last answer.",
  "properties": {
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KbCitation"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "title": "KbCitationsBlockState",
  "type": "object"
}
