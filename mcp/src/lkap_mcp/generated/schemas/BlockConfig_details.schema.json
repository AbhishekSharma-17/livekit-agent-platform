{
  "$defs": {
    "DetailsFieldConfig": {
      "additionalProperties": false,
      "description": "One starting row of a ``details`` card (the agent fills the value and may add rows).",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "date",
            "money",
            "phone",
            "email",
            "badge"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "DetailsFieldConfig",
      "type": "object"
    }
  },
  "$id": "lkap-contracts/BlockConfig_details.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``details``: one or two columns, the rows the card starts with, and whether the caller may edit.\n\n``caller_can_edit`` (V6-06) lets the caller change the value of a row on screen; the\nagent is told about each change (as data, never as instructions).",
  "properties": {
    "caller_can_edit": {
      "default": false,
      "title": "Caller Can Edit",
      "type": "boolean"
    },
    "columns": {
      "default": 1,
      "maximum": 2,
      "minimum": 1,
      "title": "Columns",
      "type": "integer"
    },
    "fields": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DetailsFieldConfig"
      },
      "title": "Fields",
      "type": "array"
    }
  },
  "title": "BlockConfig_details",
  "type": "object"
}
